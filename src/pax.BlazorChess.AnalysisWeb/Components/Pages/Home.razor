@page "/"
@using pax.BlazorChess.AnalysisWeb.Components.Analysis
@using pax.BlazorChess.AnalysisWeb.Services
@using pax.BlazorChess.Board
@using pax.chess
@using pax.chess.Analyze
@using pax.uciChessEngine.EngineServices
@inject AnalysisWorkspaceState Workspace
@inject IBoardJsInterop BoardJsInterop
@implements IAsyncDisposable
@rendermode InteractiveServer

<PageTitle>BlazorChess Analysis</PageTitle>

<main id="@analysisShellId"
      class="analysis-shell"
      tabindex="0"
      @onkeydown="OnKeyDown">
    <section class="board-column">
        <div class="board-input-surface" @onwheel="OnBoardWheel" @onwheel:preventDefault="true">
            <BoardComponent @ref="board"
                            Position="Workspace.AnalysisBoard.CurrentPosition"
                            LastMove="Workspace.LastMove"
                            OnMovePlayed="ApplyMove" />
        </div>

        <div class="position-bar">
            <label for="fenInput">FEN</label>
            <input id="fenInput" class="text-input mono" @bind="fenInput" @onkeydown:stopPropagation="true" />
        </div>

        <div class="position-bar pgn-bar">
            <label for="pgnInput">PGN</label>
            <textarea id="pgnInput" class="text-input mono" @bind="pgnInput" @onkeydown:stopPropagation="true"></textarea>
        </div>

        @if (!string.IsNullOrWhiteSpace(Workspace.ImportError))
        {
            <div class="engine-error">@Workspace.ImportError</div>
        }
    </section>

    <aside class="side-panel">
        <LiveAnalysisPanel @ref="liveAnalysis"
                           AnalysisBoard="Workspace.AnalysisBoard"
                           Engines="Workspace.EngineRunOptions"
                           SelectedEngine="Workspace.SelectedEngine"
                           SelectedEngineChanged="EngineSelected"
                           OnBestMovesReady="BestMovesReady"
                           OnNodeSelected="NodeSelected"
                           OnAnalysisChanged="RefreshBoard"
                           OnEngineSettingsChanged="EngineChanged"
                           OnSettingsClicked="OpenEngineSettings" />

        <section class="moves-panel">
            <header class="panel-title">
                <h2>Moves</h2>
                <span>@MoveCount ply</span>
            </header>
            <AnalysisAnnotationComponent @ref="annotation"
                                         AnalysisBoard="Workspace.AnalysisBoard"
                                         OnNodeClicked="NodeClicked"
                                         OnNodeContextAction="HandleMoveContextAction" />
        </section>

        <section class="controls-panel">
            <div class="nav-buttons">
                <button type="button" class="icon-button" title="Start" aria-label="Start" @onclick="GoStart">
                    <span class="bi bi-skip-backward-fill" aria-hidden="true"></span>
                </button>
                <button type="button" class="icon-button" title="Back" aria-label="Back" @onclick="GoBack">
                    <span class="bi bi-caret-left-fill" aria-hidden="true"></span>
                </button>
                <button type="button" class="icon-button" title="Forward" aria-label="Forward" @onclick="GoForward">
                    <span class="bi bi-caret-right-fill" aria-hidden="true"></span>
                </button>
                <button type="button" class="icon-button" title="End" aria-label="End" @onclick="GoEnd">
                    <span class="bi bi-skip-forward-fill" aria-hidden="true"></span>
                </button>
            </div>
            <div class="command-row">
                <button type="button" class="command-button" @onclick="LoadFen">Load FEN</button>
                <button type="button" class="command-button" @onclick="LoadPgn">Load PGN</button>
                <button type="button" class="command-button" @onclick="ResetBoard">Reset</button>
            </div>
        </section>
    </aside>

    <section class="full-analysis-panel">
        <header class="full-analysis-header">
            <div>
                <h2>Game analysis</h2>
                <span>@FullAnalysisStatus</span>
            </div>
            <div class="full-analysis-actions">
                <button type="button"
                        class="analyse-button"
                        disabled="@(!CanAnalyzeGame || fullAnalysisRunning)"
                        @onclick="AnalyzeGame">
                    <span class="bi bi-activity" aria-hidden="true"></span>
                    <span>Analyse</span>
                </button>
                @if (fullAnalysisRunning)
                {
                    <button type="button"
                            class="stop-analysis-button"
                            @onclick="StopFullAnalysis">
                        <span class="bi bi-stop-fill" aria-hidden="true"></span>
                        <span>Stop</span>
                    </button>
                }
            </div>
        </header>

        <div class="full-analysis-settings">
            <label>
                <span>Time</span>
                <div class="number-field">
                    <input class="text-input"
                           type="number"
                           min="0.1"
                           step="0.1"
                           @bind="analysisThinkTimeSeconds"
                           @bind:after="ClampAnalysisSettings"
                           @onkeydown:stopPropagation="true" />
                    <small>s</small>
                </div>
            </label>
            <label>
                <span>Threads</span>
                <div class="number-field">
                    <input class="text-input"
                           type="number"
                           min="1"
                           max="@MaxAnalysisThreads"
                           step="1"
                           @bind="analysisThreads"
                           @bind:after="ClampAnalysisSettings"
                           @onkeydown:stopPropagation="true" />
                    <small>/ @MaxAnalysisThreads</small>
                </div>
            </label>
        </div>

        <pax.BlazorChess.Board.EvaluationChart @key="analysisChartVersion"
                                               @ref="evaluationChart"
                                               ChessGame="Workspace.AnalysisBoard.ChessGame"
                                               AnalysisBoard="Workspace.AnalysisBoard"
                                               EngineRunOptions="Workspace.SelectedEngine"
                                               CurrentMoveNumber="Workspace.CurrentPly"
                                               ThinkTimePerMoveMs="AnalysisThinkTimeMs"
                                               AnalysisThreads="ClampedAnalysisThreads"
                                               Title="Evaluation"
                                               Subtitle="Main-line full-game engine analysis"
                                               ShowAnalyzeButton="false"
                                               OnMoveClicked="AnalysisMoveClicked"
                                               OnAnnotationsChanged="AnalysisAnnotationsChanged" />
    </section>
</main>

<EngineSettingsPanel @ref="engineSettings"
                     Engines="Workspace.EngineRunOptions"
                     SelectedEngine="Workspace.SelectedEngine"
                     SelectedEngineChanged="EngineSelected"
                     OnEngineAdded="EngineAdded"
                     OnEngineDeleted="EngineDeleted"
                     OnChanged="EngineChanged" />

@code {
    private BoardComponent? board;
    private LiveAnalysisPanel? liveAnalysis;
    private EngineSettingsPanel? engineSettings;
    private AnalysisAnnotationComponent? annotation;
    private pax.BlazorChess.Board.EvaluationChart? evaluationChart;
    private string fenInput = string.Empty;
    private string pgnInput = string.Empty;
    private double analysisThinkTimeSeconds = 1;
    private int analysisThreads = 8;
    private int analysisChartVersion;
    private readonly string analysisShellId = $"analysis_shell_{Guid.NewGuid():N}";
    private bool navigationKeyDefaultsRegistered;
    private bool fullAnalysisRunning;

    private int MoveCount => CountMainLineMoves();
    private int MaxAnalysisThreads => Math.Max(1, Environment.ProcessorCount);
    private int ClampedAnalysisThreads => Math.Clamp(analysisThreads, 1, MaxAnalysisThreads);
    private int AnalysisThinkTimeMs => Math.Max(100, (int)Math.Round(Math.Max(0.1, analysisThinkTimeSeconds) * 1000));
    private bool CanAnalyzeGame
        => MoveCount > 0
            && Workspace.SelectedEngine is not null
            && !string.IsNullOrWhiteSpace(Workspace.SelectedEngine.BinaryPath)
            && File.Exists(Workspace.SelectedEngine.BinaryPath);
    private string FullAnalysisStatus
        => fullAnalysisRunning
            ? $"Analysing {MoveCount} ply / {AnalysisThinkTimeMs} ms / {ClampedAnalysisThreads} threads"
            : Workspace.SelectedEngine is null
            ? "Select an engine before analysing the game."
            : MoveCount == 0
                ? "Load or play a game to analyse the main line."
                : !File.Exists(Workspace.SelectedEngine.BinaryPath)
                    ? "Selected engine binary is missing."
                    : $"{MoveCount} ply / {AnalysisThinkTimeMs} ms / {ClampedAnalysisThreads} threads";

    protected override async Task OnInitializedAsync()
    {
        await Workspace.LoadEngineSettingsAsync();
        SyncText();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await BoardJsInterop.PreventNavigationKeyDefaults(analysisShellId);
        navigationKeyDefaultsRegistered = true;
    }

    public async ValueTask DisposeAsync()
    {
        if (!navigationKeyDefaultsRegistered)
            return;

        try
        {
            await BoardJsInterop.ReleaseNavigationKeyDefaults(analysisShellId);
        }
        catch (Microsoft.JSInterop.JSDisconnectedException)
        {
        }
    }

    private async Task ApplyMove(Move move)
    {
        Workspace.ApplyMove(move);
        ResetAnalysisChart();
        board?.Update(Workspace.AnalysisBoard.CurrentPosition, move);
        SyncText();
        if (liveAnalysis is not null)
            await liveAnalysis.NotifyPositionChangedAsync();
    }

    private async Task NodeClicked(MoveNode node)
    {
        Workspace.MoveToNode(node);
        await RefreshPositionAsync();
    }

    private async Task NodeSelected(MoveNode node)
    {
        Workspace.MoveToNode(node);
        await RefreshPositionAsync();
    }

    private async Task RefreshPositionAsync()
    {
        board?.Update(Workspace.AnalysisBoard.CurrentPosition, Workspace.LastMove);
        SyncText();
        if (liveAnalysis is not null)
            await liveAnalysis.NotifyPositionChangedAsync();
    }

    private Task RefreshBoard()
    {
        board?.Update(Workspace.AnalysisBoard.CurrentPosition, Workspace.LastMove);
        SyncText();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void BestMovesReady(List<Move> moves)
    {
        board?.AddBestMoveAnnotations(moves);
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "ArrowLeft")
            await GoBack();
        else if (args.Key == "ArrowRight")
            await GoForward();
        else if (args.Key is " " or "Space" or "Spacebar")
            await ApplyCurrentBestMove();
        else if (args.Key == "Escape")
            annotation?.CloseContextMenu();
    }

    private async Task OnBoardWheel(WheelEventArgs args)
    {
        if (args.DeltaY > 0)
            await GoForward();
        else if (args.DeltaY < 0)
            await GoBack();
    }

    private async Task GoBack()
    {
        Workspace.MoveBackward();
        await RefreshPositionAsync();
    }

    private async Task GoForward()
    {
        Workspace.MoveForward();
        await RefreshPositionAsync();
    }

    private async Task GoStart()
    {
        while (!Workspace.AnalysisBoard.CurrentNode.IsRoot)
            Workspace.MoveBackward();

        await RefreshPositionAsync();
    }

    private async Task GoEnd()
    {
        while (Workspace.AnalysisBoard.CurrentNode.MainLine is not null)
            Workspace.MoveForward();

        await RefreshPositionAsync();
    }

    private async Task LoadFen()
    {
        if (Workspace.TryLoadFen(fenInput))
        {
            ResetAnalysisChart();
            await RefreshPositionAsync();
        }
        else
            StateHasChanged();
    }

    private async Task LoadPgn()
    {
        if (Workspace.TryLoadPgn(pgnInput))
        {
            ResetAnalysisChart();
            await RefreshPositionAsync();
        }
        else
            StateHasChanged();
    }

    private async Task ResetBoard()
    {
        Workspace.Reset();
        ResetAnalysisChart();
        await RefreshPositionAsync();
    }

    private async Task AnalyzeGame()
    {
        ClampAnalysisSettings();
        if (evaluationChart is null || !CanAnalyzeGame || fullAnalysisRunning)
            return;

        fullAnalysisRunning = true;
        StateHasChanged();

        try
        {
            await evaluationChart.Analyze();
        }
        finally
        {
            fullAnalysisRunning = false;
            StateHasChanged();
        }
    }

    private void StopFullAnalysis()
    {
        evaluationChart?.StopAnalysis();
    }

    private async Task AnalysisMoveClicked(int moveNumber)
    {
        if (MoveCount == 0)
            return;

        var targetPly = Math.Clamp(moveNumber <= 0 ? 1 : moveNumber, 1, MoveCount);
        var node = Workspace.AnalysisBoard.Root.MainLine;
        for (var i = 1; i < targetPly && node is not null; i++)
            node = node.MainLine;

        if (node is null)
            return;

        Workspace.MoveToNode(node);
        await RefreshPositionAsync();
    }

    private Task AnalysisAnnotationsChanged()
    {
        annotation?.Update();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task ApplyCurrentBestMove()
    {
        var move = liveAnalysis?.GetCurrentBestMove();
        if (move is null)
            return;

        await ApplyMove(move);
    }

    private async Task HandleMoveContextAction(MoveContextActionRequest request)
    {
        var changed = request.Action switch
        {
            MoveContextAction.DeleteFromHere => Workspace.DeleteFromNode(request.Node),
            MoveContextAction.MakeMainVariation => Workspace.MakeMainVariation(request.Node),
            _ => false
        };

        if (!changed)
            return;

        ResetAnalysisChart();
        annotation?.Update();
        await RefreshPositionAsync();
    }

    private void OpenEngineSettings()
    {
        engineSettings?.Open();
    }

    private async Task EngineSelected(EngineRunOptions? engine)
    {
        Workspace.SelectedEngineId = engine?.Id ?? Guid.Empty;
        await Task.CompletedTask;
    }

    private async Task EngineAdded(EngineRunOptions engine)
    {
        Workspace.SelectedEngineId = engine.Id;
        Workspace.ScheduleEngineSettingsSave();
        await NotifyEngineChangedAsync();
    }

    private async Task EngineDeleted(EngineRunOptions engine)
    {
        if (Workspace.SelectedEngineId == engine.Id)
            Workspace.SelectedEngineId = Workspace.EngineRunOptions.FirstOrDefault()?.Id ?? Guid.Empty;

        Workspace.ScheduleEngineSettingsSave();
        await NotifyEngineChangedAsync();
    }

    private async Task EngineChanged()
    {
        Workspace.ScheduleEngineSettingsSave();
        await NotifyEngineChangedAsync();
    }

    private async Task NotifyEngineChangedAsync()
    {
        if (liveAnalysis is not null)
            await liveAnalysis.NotifyEngineChangedAsync();

        StateHasChanged();
    }

    private void SyncText()
    {
        fenInput = Workspace.Fen;
        pgnInput = Workspace.Pgn;
    }

    private void ResetAnalysisChart()
    {
        analysisChartVersion++;
    }

    private void ClampAnalysisSettings()
    {
        analysisThinkTimeSeconds = Math.Max(0.1, analysisThinkTimeSeconds);
        analysisThreads = ClampedAnalysisThreads;
    }

    private int CountMainLineMoves()
    {
        var count = 0;
        var current = Workspace.AnalysisBoard.Root.MainLine;
        while (current is not null)
        {
            count++;
            current = current.MainLine;
        }

        return count;
    }
}
