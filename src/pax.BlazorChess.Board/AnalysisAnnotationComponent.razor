@using pax.chess
@using pax.chess.Analyze;
@using System.Runtime.CompilerServices
@inject IBoardJsInterop BoardJsInterop

<div id="@AnnotationGuid" class="table-responsive" style="max-height: 50vh; max-width: 500px;">
    <table class="table table-sm table-striped">
        <colgroup>
            <col width="50px;" />
            <col width="100px;" />
            <col width="100px;" />
        </colgroup>
        <thead>
            <tr>
                <th>#</th>
                <th>White</th>
                <th>Black</th>
            </tr>
        </thead>
        <tbody>
            @{
                var mainLine = GetMainLine();
            }
            @for (int i = 0; i < mainLine.Count; i += 2)
            {
                var moveNumber = i / 2 + 1;
                var whiteMove = mainLine[i];
                var blackMove = (i + 1 < mainLine.Count) ? mainLine[i + 1] : null;
                <tr style="cursor: pointer;">
                    <td @onclick="() => NodeClicked(whiteMove)">@moveNumber.</td>
                    <td id="@GetNodeElementId(whiteMove)"
                        class="@GetNodeCss(whiteMove)"
                        @onclick="() => NodeClicked(whiteMove)"
                        @oncontextmenu="(e) => OpenContextMenu(whiteMove, e)"
                        @oncontextmenu:preventDefault="true">@whiteMove.San</td>
                    @if (blackMove != null)
                    {
                        <td id="@GetNodeElementId(blackMove)"
                            class="@GetNodeCss(blackMove)"
                            @onclick="() => NodeClicked(blackMove)"
                            @oncontextmenu="(e) => OpenContextMenu(blackMove, e)"
                            @oncontextmenu:preventDefault="true">@blackMove.San</td>
                    }
                    else
                {
                        <td></td>
                    }
                </tr>
                <VariationList Node="whiteMove"
                               AnnotationGuid="AnnotationGuid"
                               CurrentNode="AnalysisBoard.CurrentNode"
                               OnNodeClicked="OnNodeClicked"
                               OnNodeContextMenu="OpenVariationContextMenu" />
                @if (blackMove != null)
                {
                    <VariationList Node="blackMove"
                                   AnnotationGuid="AnnotationGuid"
                                   CurrentNode="AnalysisBoard.CurrentNode"
                                   OnNodeClicked="OnNodeClicked"
                                   OnNodeContextMenu="OpenVariationContextMenu" />
                }
            }
        </tbody>
    </table>
</div>

@if (contextMenuNode is not null)
{
    <div class="move-context-backdrop"
         @onclick="CloseContextMenu"
         @oncontextmenu:preventDefault="true"></div>
    <div class="move-context-menu"
         style="@GetContextMenuStyle()"
         @onclick:stopPropagation="true">
        @if (CanMakeMainVariation(contextMenuNode))
        {
            <button type="button" @onclick="() => InvokeContextAction(MoveContextAction.MakeMainVariation)">Make to main variation</button>
        }
        <button type="button" @onclick="() => InvokeContextAction(MoveContextAction.DeleteFromHere)">Delete from here</button>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public required pax.chess.Analyze.AnalysisBoard AnalysisBoard { get; set; }

    [Parameter]
    public Guid AnnotationGuid { get; set; } = Guid.NewGuid();

    [Parameter]
    public EventCallback<pax.chess.Analyze.MoveNode> OnNodeClicked { get; set; }

    [Parameter]
    public EventCallback<MoveContextActionRequest> OnNodeContextAction { get; set; }

    private pax.chess.Analyze.MoveNode? contextMenuNode;
    private pax.chess.Analyze.MoveNode? lastScrolledNode;
    private double contextMenuX;
    private double contextMenuY;

    public void Update()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var currentNode = AnalysisBoard.CurrentNode;
        if (currentNode.IsRoot || ReferenceEquals(currentNode, lastScrolledNode))
            return;

        lastScrolledNode = currentNode;
        await BoardJsInterop.ScrollToElement(GetNodeElementId(currentNode));
    }

    public void CloseContextMenu()
    {
        contextMenuNode = null;
        InvokeAsync(StateHasChanged);
    }

    private async Task NodeClicked(pax.chess.Analyze.MoveNode node)
    {
        contextMenuNode = null;
        await OnNodeClicked.InvokeAsync(node);
    }

    private void OpenContextMenu(pax.chess.Analyze.MoveNode node, MouseEventArgs args)
    {
        contextMenuNode = node;
        contextMenuX = args.ClientX;
        contextMenuY = args.ClientY;
    }

    private void OpenVariationContextMenu(MoveContextMenuRequest request)
    {
        OpenContextMenu(request.Node, request.Args);
    }

    private async Task InvokeContextAction(MoveContextAction action)
    {
        if (contextMenuNode is null)
            return;

        var node = contextMenuNode;
        contextMenuNode = null;
        await OnNodeContextAction.InvokeAsync(new MoveContextActionRequest(node, action));
    }

    private string GetContextMenuStyle()
    {
        return $"left:{contextMenuX}px;top:{contextMenuY}px;";
    }

    private static bool CanMakeMainVariation(pax.chess.Analyze.MoveNode node)
    {
        return node.Parent is not null && node.Parent.MainLine != node;
    }

    private List<pax.chess.Analyze.MoveNode> GetMainLine()
    {
        var current = AnalysisBoard.Root.MainLine;
        List<pax.chess.Analyze.MoveNode> mainLine = new();
        while (current != null)
        {
            mainLine.Add(current);
            current = current.MainLine;
        }
        return mainLine;
    }

    private string GetNodeCss(pax.chess.Analyze.MoveNode node)
    {
        return AnalysisBoard.CurrentNode == node ? "fw-bold" : "";
    }

    private string GetNodeElementId(pax.chess.Analyze.MoveNode node)
        => $"{AnnotationGuid:N}_node_{RuntimeHelpers.GetHashCode(node)}";
}
