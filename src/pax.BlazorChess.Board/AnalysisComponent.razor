@using pax.chess
@using pax.chess.Analyze
@using pax.chess.Extensions
@using pax.uciChessEngine
@using pax.uciChessEngine.EngineServices
@using System.Linq
@using pax.BlazorChess.Board
@inject IChessBoardRepository ChessBoardRepository
@implements IAsyncDisposable

<div class="container-fluid">
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(activeTab == AnalysisTab.Analysis ? "active" : "")" @onclick="() => activeTab = AnalysisTab.Analysis">Analysis</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == AnalysisTab.EngineGames ? "active" : "")" @onclick="() => activeTab = AnalysisTab.EngineGames">Engine Games</button>
        </li>
    </ul>

    @if (activeTab == AnalysisTab.Analysis)
    {
        <div class="row" tabindex="0" @onkeydown="KeyDown">
            <div class="col-2 mt-3 d-flex flex-column gap-2">
                <button type="button" class="btn btn-primary" @onclick="OpenImportModal">Import PGN</button>
                <button type="button" class="btn btn-outline-light" @onclick="() => showChart = !showChart">
                    @(showChart ? "Hide Chart" : "Show Chart")
                </button>
                <div class="d-flex flex-column">
                    <label class="form-label mb-1 small text-secondary">Think time per move (ms)</label>
                    <input type="number" class="form-control form-control-sm" min="100" step="100" @bind="thinkTimePerMoveMs" @bind:after="ClampThinkTime" />
                </div>
            </div>
            <div class="col-5 mt-3">
                <BoardComponent @ref="boardComponent" Position="AnalysisBoard.CurrentPosition" OnMovePlayed="ApplyMove" />
            </div>
            <div class="col-3">
                <div class="mt-3 mb-3">
                    <LiveEvalComponent @ref="liveEvalComponent" AnalysisBoard="AnalysisBoard" EngineRunOptions="engineRunOptions" OnBestMovesReady="BestMovesReady" />
                </div>
                <div class="mb-3">
                    <AnalysisAnnotationComponent @ref="annotationComponent" AnalysisBoard="AnalysisBoard" OnNodeClicked="NodeClicked" />
                </div>
            </div>
        </div>
        @if (showChart && engineRunOptions.Count > 0)
        {
            <div>
                <GameAnalisisComponent ChessGame="AnalysisBoard.ChessGame"
                                       AnalysisBoard="AnalysisBoard"
                                       EngineRunOptions="engineRunOptions.First()"
                                       ThinkTimePerMoveMs="thinkTimePerMoveMs"
                                       OnMoveClicked="ChartMoveClicked"
                                       OnAnnotationsChanged="AnnotationsChanged" />
            </div>
        }
    }
    else
    {
        <div class="row">
            <div class="col-3">
                <div class="card bg-dark text-light mb-3 border-secondary">
                    <div class="card-body">
                        <h6 class="card-title">Start Engine Game from this position</h6>
                        <div class="mb-2">
                            <label class="form-label small text-secondary">White engine</label>
                            <select class="form-select form-select-sm" @bind="selectedWhiteEngineId">
                                @foreach (var opt in engineRunOptions)
                                {
                                    <option value="@opt.Id">@(!string.IsNullOrEmpty(opt.Name) ? opt.Name : opt.BinaryPath)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-secondary">Black engine</label>
                            <select class="form-select form-select-sm" @bind="selectedBlackEngineId">
                                @foreach (var opt in engineRunOptions)
                                {
                                    <option value="@opt.Id">@(!string.IsNullOrEmpty(opt.Name) ? opt.Name : opt.BinaryPath)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-secondary">Base time (minutes)</label>
                            <input type="number" class="form-control form-control-sm" min="1" max="180" @bind="engineBaseMinutes" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-secondary">Increment (seconds)</label>
                            <input type="number" class="form-control form-control-sm" min="0" max="120" @bind="engineIncrementSeconds" />
                        </div>
                        <button class="btn btn-primary w-100" @onclick="StartEngineGame" disabled="@(engineRunOptions.Count < 1)">Play out from this position</button>
                    </div>
                </div>
            </div>
            <div class="col-9">
                @if (engineGameSessions.Count == 0)
                {
                    <div class="alert alert-secondary">No engine games yet. Start one from the left.</div>
                }
                else
                {
                    <ul class="nav nav-pills mb-3">
                        @foreach (var game in engineGameSessions)
                        {
                            <li class="nav-item">
                                <button class="nav-link @(activeEngineGameId == game.Id ? "active" : "")" @onclick="() => SelectEngineGame(game.Id)">
                                    @game.Name
                                    @if (!string.IsNullOrEmpty(game.Result))
                                    {
                                        <span class="badge bg-secondary ms-1">@game.Result</span>
                                    }
                                </button>
                            </li>
                        }
                    </ul>

                    <EngineGameViewer Session="ActiveEngineGame"
                                      OnStopRequested="() => StopEngineGame(ActiveEngineGame)" />
                }
            </div>
        </div>
    }

    @if (showImportModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);" aria-modal="true" role="dialog">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Import PGN</h5>
                        <button type="button" class="btn-close" @onclick="CloseImportModal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label" for="pgnTextarea">Paste PGN</label>
                            <textarea id="pgnTextarea" class="form-control" rows="10" @bind="pgnText"></textarea>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(importError))
                        {
                            <div class="alert alert-danger mb-0">@importError</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseImportModal">Cancel</button>
                        <button type="button" class="btn btn-primary" @onclick="ImportPgn" disabled="@(string.IsNullOrWhiteSpace(pgnText))">Import</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private enum AnalysisTab
    {
        Analysis,
        EngineGames
    }

    [Parameter, EditorRequired]
    public required pax.chess.Analyze.AnalysisBoard AnalysisBoard { get; set; }

    private BoardComponent? boardComponent;
    private AnalysisAnnotationComponent? annotationComponent;
    private ClockComponent? clockComponent;
    private LiveEvalComponent? liveEvalComponent;

    List<EngineRunOptions> engineRunOptions = [];

    private bool showChart;
    private bool showImportModal;
    private string pgnText = string.Empty;
    private string? importError;
    private int thinkTimePerMoveMs = 1000;
    private AnalysisTab activeTab = AnalysisTab.Analysis;

    private Guid selectedWhiteEngineId;
    private Guid selectedBlackEngineId;
    private int engineBaseMinutes = 5;
    private int engineIncrementSeconds = 3;
    private Guid? activeEngineGameId;
    private readonly List<EngineGameSession> engineGameSessions = [];

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        engineRunOptions = await ChessBoardRepository.GetEngineRunOptions();
        selectedWhiteEngineId = engineRunOptions.FirstOrDefault()?.Id ?? Guid.Empty;
        selectedBlackEngineId = engineRunOptions.Skip(1).FirstOrDefault()?.Id
            ?? engineRunOptions.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    public void ApplyMove(Move move)
    {
        var san = PgnSerializer.ToSan(move, AnalysisBoard.CurrentPosition);
        AnalysisBoard.AddVariation(move);
        boardComponent?.Update(AnalysisBoard.CurrentPosition, move);
        liveEvalComponent?.Update();
    }

    public void ApplyEngineMove(string engineMove)
    {
        var move = Uci.CreateMove(engineMove, AnalysisBoard.CurrentPosition);
        ArgumentNullException.ThrowIfNull(move);
        var san = PgnSerializer.ToSan(move, AnalysisBoard.CurrentPosition);
        AnalysisBoard.AddVariation(move);
        boardComponent?.Update(AnalysisBoard.CurrentPosition, move);
        liveEvalComponent?.Update();
    }

    private void NodeClicked(chess.Analyze.MoveNode args)
    {
        AnalysisBoard.MoveToNode(args);
        liveEvalComponent?.Update();
    }

    private void KeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "ArrowLeft")
        {
            AnalysisBoard.MoveBackward();
            liveEvalComponent?.Update();
        }
        else if (args.Key == "ArrowRight")
        {
            AnalysisBoard.MoveForward();
            liveEvalComponent?.Update();
        }
    }
    private void BestMovesReady(List<Move> args)
    {
        boardComponent?.AddBestMoveAnnotations(args);
    }

    private void ChartMoveClicked(int args)
    {
        var mainLine = GetMainLine();
        var index = args - 1;
        if (mainLine.Count > index)
        {
            var node = mainLine[index];
            NodeClicked(node);
        }
    }

    private List<pax.chess.Analyze.MoveNode> GetMainLine()
    {
        var current = AnalysisBoard.Root.MainLine;
        List<pax.chess.Analyze.MoveNode> mainLine = new();
        while (current != null)
        {
            mainLine.Add(current);
            current = current.MainLine;
        }
        return mainLine;
    }

    private void OpenImportModal()
    {
        pgnText = string.Empty;
        importError = null;
        showImportModal = true;
    }

    private void CloseImportModal()
    {
        showImportModal = false;
        importError = null;
    }

    private void ImportPgn()
    {
        try
        {
            var game = PgnSerializer.Parse(pgnText);
            AnalysisBoard = new pax.chess.Analyze.AnalysisBoard(game);
            showChart = false;
            showImportModal = false;
            importError = null;

            boardComponent?.Update(AnalysisBoard.CurrentPosition, null);
            liveEvalComponent?.Update();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            importError = $"Could not import PGN: {ex.Message}";
        }
    }

    private void ClampThinkTime()
    {
        if (thinkTimePerMoveMs < 100)
            thinkTimePerMoveMs = 100;
    }

    private Task AnnotationsChanged()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    private EngineGameSession? ActiveEngineGame => activeEngineGameId.HasValue
        ? engineGameSessions.FirstOrDefault(g => g.Id == activeEngineGameId.Value)
        : null;

    private async Task StartEngineGame()
    {
        var white = engineRunOptions.FirstOrDefault(o => o.Id == selectedWhiteEngineId)
            ?? engineRunOptions.FirstOrDefault();
        var black = engineRunOptions.FirstOrDefault(o => o.Id == selectedBlackEngineId)
            ?? engineRunOptions.FirstOrDefault();

        if (white is null || black is null)
            return;

        var startPosition = AnalysisBoard.CurrentPosition.Clone();
        var clock = new ChessClock(
            TimeSpan.FromMinutes(Math.Max(1, engineBaseMinutes)),
            TimeSpan.FromSeconds(Math.Max(0, engineIncrementSeconds)));

        var game = new ChessGame(startPosition, new GameMetadata(), clock);

        var whiteEngine = new UciEngine(white.BinaryPath);
        var blackEngine = new UciEngine(black.BinaryPath);
        var threads = Math.Max(1, Math.Max(white.Threads, black.Threads));

        var engineGame = new EngineGame(whiteEngine, blackEngine, game, threads);

        var session = new EngineGameSession
        {
            EngineGame = engineGame,
            Game = game,
            Clock = clock,
            WhiteEngine = !string.IsNullOrEmpty(white.Name) ? white.Name! : white.BinaryPath,
            BlackEngine = !string.IsNullOrEmpty(black.Name) ? black.Name! : black.BinaryPath,
            Name = $"Game {engineGameSessions.Count + 1}"
        };

        engineGame.MoveReady += (_, e) => OnEngineMoveReady(session, e);
        engineGame.GameFinished += (_, _) => OnEngineGameFinished(session);

        engineGameSessions.Add(session);
        activeEngineGameId = session.Id;
        activeTab = AnalysisTab.EngineGames;

        await engineGame.Start(clock);
        session.IsRunning = true;
        await InvokeAsync(StateHasChanged);
    }

    private void OnEngineMoveReady(EngineGameSession session, EngineMoveEventArgs e)
    {
        var lastMove = session.Game.Moves.LastOrDefault()?.Move;
        var sideToMove = session.Game.CurrentPosition.SideToMove;
        if (e.Eval != null)
        {
            if (sideToMove == PieceColor.White)
                session.WhiteEval = e.Eval;
            else
                session.BlackEval = e.Eval;
        }
        session.BoardComponent?.Update(session.Game.CurrentPosition, lastMove);
        InvokeAsync(StateHasChanged);
    }

    private void OnEngineGameFinished(EngineGameSession session)
    {
        session.IsRunning = false;
        session.Result = session.Game.Result?.ToString() ?? "Finished";
        InvokeAsync(StateHasChanged);
    }

    private void SelectEngineGame(Guid id)
    {
        activeEngineGameId = id;
    }

    private async Task StopEngineGame(EngineGameSession? session)
    {
        if (session is null || !session.IsRunning)
            return;

        try
        {
            await session.EngineGame.StopGame();
        }
        catch (OperationCanceledException)
        {
            // Expected when the engine loop is cancelled; safely ignore.
        }
        session.IsRunning = false;
        session.Result ??= "Stopped";
        await InvokeAsync(StateHasChanged);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        foreach (var game in engineGameSessions)
        {
            if (!game.DisplayAttached && game.ClockComponent != null)
            {
                game.Clock.AttachDisplay(game.ClockComponent);
                game.DisplayAttached = true;
            }
        }

        return base.OnAfterRenderAsync(firstRender);
    }

    public async ValueTask DisposeAsync()
    {
        foreach (var session in engineGameSessions)
        {
            await session.EngineGame.DisposeAsync();
        }
    }

}
