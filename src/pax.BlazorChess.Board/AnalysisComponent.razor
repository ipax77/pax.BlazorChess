@using pax.chess
@using pax.chess.Analyze
@using pax.chess.Extensions
@using pax.uciChessEngine
@using pax.uciChessEngine.EngineServices
@inject IChessBoardRepository ChessBoardRepository

<div class="container-fluid">
    <div class="row" tabindex="0" @onkeydown="KeyDown">
        <div class="col-2">
        </div>
        <div class="col-5 mt-3">
            <BoardComponent @ref="boardComponent" Position="AnalysisBoard.CurrentPosition" OnMovePlayed="ApplyMove" />
        </div>
        <div class="col-3">
            <div class="mt-3 mb-3">
                <LiveEvalComponent @ref="liveEvalComponent" AnalysisBoard="AnalysisBoard" EngineRunOptions="engineRunOptions" OnBestMovesReady="BestMovesReady" />
            </div>
            <div class="mb-3">
                <AnalysisAnnotationComponent @ref="annotationComponent" AnalysisBoard="AnalysisBoard" OnNodeClicked="NodeClicked" />
            </div>
        </div>
    </div>
    <div>
        <button type="button" class="btn btn-outline-light" @onclick="() => showChart = !showChart">Show Chart</button>
    </div>
    @if (showChart && engineRunOptions.Count > 0)
    {
        <div>
            <GameAnalisisComponent ChessGame="AnalysisBoard.ChessGame" EngineRunOptions="engineRunOptions.First()" OnMoveClicked="ChartMoveClicked" />
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required pax.chess.Analyze.AnalysisBoard AnalysisBoard { get; set; }

    private BoardComponent? boardComponent;
    private AnalysisAnnotationComponent? annotationComponent;
    private ClockComponent? clockComponent;
    private LiveEvalComponent? liveEvalComponent;

    List<EngineRunOptions> engineRunOptions = [];

    private bool showChart;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        engineRunOptions = await ChessBoardRepository.GetEngineRunOptions();
    }

    public void ApplyMove(Move move)
    {
        var san = PgnSerializer.ToSan(move, AnalysisBoard.CurrentPosition);
        AnalysisBoard.AddVariation(move);
        boardComponent?.Update(AnalysisBoard.CurrentPosition, move);
        liveEvalComponent?.Update();
    }

    public void ApplyEngineMove(string engineMove)
    {
        var move = Uci.CreateMove(engineMove, AnalysisBoard.CurrentPosition);
        ArgumentNullException.ThrowIfNull(move);
        var san = PgnSerializer.ToSan(move, AnalysisBoard.CurrentPosition);
        AnalysisBoard.AddVariation(move);
        boardComponent?.Update(AnalysisBoard.CurrentPosition, move);
        liveEvalComponent?.Update();
    }

    private void NodeClicked(chess.Analyze.MoveNode args)
    {
        AnalysisBoard.MoveToNode(args);
        liveEvalComponent?.Update();
    }

    private void KeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "ArrowLeft")
        {
            AnalysisBoard.MoveBackward();
            liveEvalComponent?.Update();
        }
        else if (args.Key == "ArrowRight")
        {
            AnalysisBoard.MoveForward();
            liveEvalComponent?.Update();
        }
    }
    private void BestMovesReady(List<Move> args)
    {
        boardComponent?.AddBestMoveAnnotations(args);
    }

    private void ChartMoveClicked(int args)
    {
        var mainLine = GetMainLine();
        var index = args - 1;
        if (mainLine.Count > index)
        {
            var node = mainLine[index];
            NodeClicked(node);
        }
    }

    private List<pax.chess.Analyze.MoveNode> GetMainLine()
    {
        var current = AnalysisBoard.Root.MainLine;
        List<pax.chess.Analyze.MoveNode> mainLine = new();
        while (current != null)
        {
            mainLine.Add(current);
            current = current.MainLine;
        }
        return mainLine;
    }
}