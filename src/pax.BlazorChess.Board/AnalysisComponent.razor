@using pax.chess
@using pax.chess.Analyze
@using pax.chess.Extensions
@using pax.uciChessEngine
@using pax.uciChessEngine.EngineServices
@using System.Linq
@using pax.BlazorChess.Board
@using pax.BlazorChess.Board.Modals
@inject IChessBoardRepository ChessBoardRepository
@implements IAsyncDisposable

<div class="container-fluid">
    <ul class="nav nav-tabs mb-3 flex-wrap">
        <li class="nav-item">
            <button class="nav-link @(activeTab == AnalysisTab.Analysis ? "active" : "")" @onclick="() => activeTab = AnalysisTab.Analysis">Analysis</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == AnalysisTab.EngineGames ? "active" : "")" @onclick="() => activeTab = AnalysisTab.EngineGames">Engine Games</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == AnalysisTab.EngineMatches ? "active" : "")" @onclick="() => activeTab = AnalysisTab.EngineMatches">Engine Matches</button>
        </li>
    </ul>

    @if (engineRunOptions.Count == 0)
    {
        <div class="alert alert-warning">
            No engine settings found. Please add at least one engine.
            <button type="button" class="btn btn-outline-primary" @onclick="OpenEngineSettingsModal">Engine settings</button>
        </div>
    }

    @if (activeTab == AnalysisTab.Analysis)
    {
        <div class="row g-3 mt-3 analysis-keyboard-focus" tabindex="0" @onkeydown="KeyDown" @onkeydown:preventDefault="true">
            <div class="col-12 col-md-4 col-lg-3 col-xl-2 d-flex flex-column gap-2">
                <button type="button" class="btn btn-primary w-100" @onclick="OpenImportModal">Import PGN</button>
                <button type="button" class="btn btn-secondary w-100" @onclick="OpenSaveModal">Save analysis</button>
                <button type="button" class="btn btn-outline-secondary w-100" @onclick="OpenLoadModal">Load analysis</button>
                <button type="button" class="btn btn-outline-primary w-100" @onclick="OpenEngineSettingsModal">Engine settings</button>
                <button type="button" class="btn btn-outline-light w-100" @onclick="ShowAnalysis">
                    @(showChart ? "Stop Analysis" : "Start Analysis")
                </button>
                <div class="d-flex flex-column">
                    <label class="form-label mb-1 small text-secondary">Think time per move (ms)</label>
                    <input type="number" class="form-control form-control-sm" min="100" step="100" @bind="thinkTimePerMoveMs" @bind:after="ClampThinkTime" />
                </div>
            </div>
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <BoardComponent @ref="boardComponent" Position="AnalysisBoard.CurrentPosition" OnMovePlayed="ApplyMove" />
            </div>
            <div class="col-12 col-lg-3">
                <div class="mb-3">
                    <LiveEvalComponent @ref="liveEvalComponent" AnalysisBoard="AnalysisBoard" EngineRunOptions="engineRunOptions" OnBestMovesReady="BestMovesReady" />
                </div>
                <div class="mb-3">
                    <AnalysisAnnotationComponent @ref="annotationComponent" AnalysisBoard="AnalysisBoard" OnNodeClicked="NodeClicked" />
                </div>
            </div>
        </div>
        @if (engineRunOptions.Count > 0)
        {
            <div class="mt-1">
                <GameAnalysisComponent @ref="gameAnalisisComponent" ChessGame="AnalysisBoard.ChessGame"
                                       AnalysisBoard="AnalysisBoard"
                                       EngineRunOptions="engineRunOptions.First()"
                                       ThinkTimePerMoveMs="thinkTimePerMoveMs"
                                       OnMoveClicked="ChartMoveClicked"
                                       OnAnnotationsChanged="AnnotationsChanged" />
            </div>
        }
    }
    else if (activeTab == AnalysisTab.EngineGames)
    {
        <div class="row g-3">
            <div class="col-12 col-lg-4 col-xl-3">
                <div class="card bg-dark text-light mb-3 border-secondary">
                    <div class="card-body">
                        <h6 class="card-title">Start Engine Game from this position</h6>
                        <div class="mb-2">
                            <label class="form-label small text-secondary">White engine</label>
                            <select class="form-select form-select-sm" @bind="selectedWhiteEngineId" @bind:after="UpdateEngineMatchConcurrency">
                                @foreach (var opt in engineRunOptions)
                                {
                                    <option value="@opt.Id">@(!string.IsNullOrEmpty(opt.Name) ? opt.Name : opt.BinaryPath)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-secondary">Black engine</label>
                            <select class="form-select form-select-sm" @bind="selectedBlackEngineId" @bind:after="UpdateEngineMatchConcurrency">
                                @foreach (var opt in engineRunOptions)
                                {
                                    <option value="@opt.Id">@(!string.IsNullOrEmpty(opt.Name) ? opt.Name : opt.BinaryPath)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-secondary">Base time (minutes)</label>
                            <input type="number" class="form-control form-control-sm" min="1" max="180" @bind="engineBaseMinutes" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-secondary">Increment (seconds)</label>
                            <input type="number" class="form-control form-control-sm" min="0" max="120" @bind="engineIncrementSeconds" />
                        </div>
                        <button class="btn btn-primary w-100" @onclick="StartEngineGame" disabled="@(engineRunOptions.Count < 1)">Play out from this position</button>
                    </div>
                    <div style="width: 100% !important;">
                        <BoardComponent Position="AnalysisBoard.CurrentPosition.Clone()" />
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-8 col-xl-9">
                @if (engineGameSessions.Count == 0)
                {
                    <div class="alert alert-secondary">No engine games yet. Start one from the left.</div>
                }
                else
                {
                    <ul class="nav nav-pills mb-3">
                        @foreach (var game in engineGameSessions)
                        {
                            <li class="nav-item">
                                <button class="nav-link @(activeEngineGameId == game.Id ? "active" : "")" @onclick="() => SelectEngineGame(game.Id)">
                                    @game.Name
                                    @if (!string.IsNullOrEmpty(game.Result))
                                    {
                                        <span class="badge bg-secondary ms-1">@game.Result</span>
                                    }
                                </button>
                            </li>
                        }
                    </ul>

                    <EngineGameViewer Session="ActiveEngineGame"
                                      OnStopRequested="async () => await StopEngineGame(ActiveEngineGame)" />
                }
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-12 col-lg-4 col-xl-3">
                <div class="card bg-dark text-light mb-3 border-secondary">
                    <div class="card-body">
                        <h6 class="card-title">Run engine matches from this position</h6>
                        <div class="mb-2">
                            <label class="form-label small text-secondary">White engine</label>
                            <select class="form-select form-select-sm" @bind="selectedWhiteEngineId" @bind:after="UpdateEngineMatchConcurrency">
                                @foreach (var opt in engineRunOptions)
                                {
                                    <option value="@opt.Id">@(!string.IsNullOrEmpty(opt.Name) ? opt.Name : opt.BinaryPath)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-secondary">Black engine</label>
                            <select class="form-select form-select-sm" @bind="selectedBlackEngineId" @bind:after="UpdateEngineMatchConcurrency">
                                @foreach (var opt in engineRunOptions)
                                {
                                    <option value="@opt.Id">@(!string.IsNullOrEmpty(opt.Name) ? opt.Name : opt.BinaryPath)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-secondary">Matches</label>
                            <input type="number" class="form-control form-control-sm" min="1" max="200" @bind="engineMatchCount" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-secondary">Base time (minutes)</label>
                            <input type="number" class="form-control form-control-sm" min="1" max="180" @bind="engineBaseMinutes" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-secondary">Increment (seconds)</label>
                            <input type="number" class="form-control form-control-sm" min="0" max="120" @bind="engineIncrementSeconds" />
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="reverseEngines" @bind="engineMatchReverseEngines" />
                            <label class="form-check-label small text-secondary" for="reverseEngines">
                                Reverse engines every other game
                            </label>
                        </div>
                        <div class="small text-secondary mb-3">
                            Max concurrent: @engineMatchMaxConcurrentDisplay
                        </div>
                        <button class="btn btn-primary w-100 mb-2" @onclick="StartEngineMatches" disabled="@(engineRunOptions.Count < 1 || engineMatchesRunning)">
                            @(engineMatchesRunning ? "Running..." : "Run matches")
                        </button>
                        <button class="btn btn-outline-light w-100" @onclick="StopEngineMatches" disabled="@(!engineMatchesRunning)">Stop matches</button>
                    </div>
                    <div style="width: 100% !important;">
                        <BoardComponent Position="AnalysisBoard.CurrentPosition.Clone()" />
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-8 col-xl-9">
                @if (engineMatchResults.Count == 0)
                {
                    <div class="alert alert-secondary">No matches yet. Start a batch from the left.</div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge bg-secondary">Total: @engineMatchResults.Count</span>
                        <span class="badge bg-success">White wins: @engineMatchWhiteWins</span>
                        <span class="badge bg-danger">Black wins: @engineMatchBlackWins</span>
                        <span class="badge bg-warning text-dark">Draws: @engineMatchDraws</span>
                        @if (engineMatchesRunning)
                        {
                            <span class="badge bg-info text-dark">Running: @engineMatchRunningCount</span>
                        }
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-dark table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>White</th>
                                    <th>Black</th>
                                    <th>Result</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var match in engineMatchResults)
                                {
                                    <tr>
                                        <td>@match.Index</td>
                                        <td>@match.WhiteEngine</td>
                                        <td>@match.BlackEngine</td>
                                        <td>@(match.Result?.ToString() ?? "-")</td>
                                        <td>@match.Status</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-light" disabled="@(match.Game is null)" @onclick="() => ViewEngineMatch(match)">
                                                View game
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (engineMatchViewBoard is not null)
                    {
                        <div class="card bg-dark text-light border-secondary mt-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <div class="fw-bold">Match @engineMatchViewLabel</div>
                                <button class="btn btn-sm btn-outline-light" @onclick="ClearEngineMatchView">Close</button>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-6">
                                        <BoardComponent @ref="engineMatchBoardRef" Position="engineMatchViewBoard.CurrentPosition" />
                                    </div>
                                    <div class="col-5">
                                        <div class="small text-secondary">Side to move: @engineMatchViewBoard.CurrentPosition.SideToMove</div>
                                        <div class="small text-secondary">Moves played: @engineMatchViewBoard.ChessGame.Moves.Count</div>
                                        <div class="mt-2">Result: @(engineMatchViewBoard.ChessGame.Result?.ToString() ?? "-")</div>
                                        <div class="mt-3" style="height: 600px !important;">
                                            <AnalysisAnnotationComponent AnalysisBoard="engineMatchViewBoard" OnNodeClicked="EngineMatchNodeClicked" />
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex gap-2 mt-3">
                                    <button class="btn btn-sm btn-outline-light" @onclick="EngineMatchBack">Back</button>
                                    <button class="btn btn-sm btn-outline-light" @onclick="EngineMatchForward">Forward</button>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }

    @if (showImportModal)
    {
        <ImportPgnModal PgnText="@pgnText"
                        PgnTextChanged="@(value => pgnText = value)"
                        ImportError="@importError"
                        OnClose="CloseImportModal"
                        OnImport="ImportPgn" />
    }

    @if (showSaveModal)
    {
        <SaveAnalysisModal SaveName="@saveName"
                           SaveNameChanged="@(value => saveName = value)"
                           SaveError="@saveError"
                           OnClose="CloseSaveModal"
                           OnSave="SaveAnalysis" />
    }

    @if (showLoadModal)
    {
        <LoadAnalysisModal SavedAnalyses="savedAnalyses"
                           SelectedLoadId="selectedLoadId"
                           SelectedLoadIdChanged="@(value => selectedLoadId = value)"
                           LoadError="@loadError"
                           OnClose="CloseLoadModal"
                           OnLoad="LoadSelectedAnalysis" />
    }

    @if (showEngineSettingsModal)
    {
        <EngineSettingsModal EngineRunOptions="engineRunOptions"
                             OnOptionsUpdated="StoreEngineRunOptions"
                             OnClose="CloseEngineSettingsModal" />
    }
</div>

@code {
    private enum AnalysisTab
    {
        Analysis,
        EngineGames,
        EngineMatches
    }

    [Parameter, EditorRequired]
    public required pax.chess.Analyze.AnalysisBoard AnalysisBoard { get; set; }

    private BoardComponent? boardComponent;
    private AnalysisAnnotationComponent? annotationComponent;
    private ClockComponent? clockComponent;
    private LiveEvalComponent? liveEvalComponent;
    private GameAnalysisComponent? gameAnalisisComponent;

    List<EngineRunOptions> engineRunOptions = [];

    private bool showChart;
    private bool showImportModal;
    private bool showSaveModal;
    private bool showLoadModal;
    private bool showEngineSettingsModal;
    private string pgnText = string.Empty;
    private string? importError;
    private string saveName = string.Empty;
    private string? saveError;
    private string? loadError;
    private int thinkTimePerMoveMs = 1000;
    private AnalysisTab activeTab = AnalysisTab.Analysis;

    private Guid selectedWhiteEngineId;
    private Guid selectedBlackEngineId;
    private int engineBaseMinutes = 5;
    private int engineIncrementSeconds = 3;
    private Guid? activeEngineGameId;
    private readonly List<EngineGameSession> engineGameSessions = [];
    private readonly List<AnalyzedGameSummary> savedAnalyses = [];
    private Guid? selectedLoadId;
    private int engineMatchCount = 10;
    private bool engineMatchReverseEngines = true;
    private int engineMatchMaxConcurrentDisplay = 1;
    private readonly EngineMatchBatch engineMatchBatch = new();
    private IReadOnlyList<EngineMatchSummary> engineMatchResults => engineMatchBatch.Matches;
    private AnalysisBoard? engineMatchViewBoard;
    private string engineMatchViewLabel = string.Empty;
    private BoardComponent? engineMatchBoardRef;
    private bool engineMatchesRunning => engineMatchBatch.IsRunning;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        engineRunOptions = await ChessBoardRepository.GetEngineRunOptions();
        selectedWhiteEngineId = engineRunOptions.FirstOrDefault()?.Id ?? Guid.Empty;
        selectedBlackEngineId = engineRunOptions.Skip(1).FirstOrDefault()?.Id
            ?? engineRunOptions.FirstOrDefault()?.Id ?? Guid.Empty;
        UpdateEngineMatchConcurrency();
        engineMatchBatch.MatchUpdated += OnEngineMatchUpdated;
        engineMatchBatch.BatchFinished += OnEngineMatchBatchFinished;
    }

    public void ApplyMove(Move move)
    {
        var san = PgnSerializer.ToSan(move, AnalysisBoard.CurrentPosition);
        AnalysisBoard.AddVariation(move);
        boardComponent?.Update(AnalysisBoard.CurrentPosition, move);
        liveEvalComponent?.Update();
    }

    public void ApplyEngineMove(string engineMove)
    {
        var move = Uci.CreateMove(engineMove, AnalysisBoard.CurrentPosition);
        ArgumentNullException.ThrowIfNull(move);
        var san = PgnSerializer.ToSan(move, AnalysisBoard.CurrentPosition);
        AnalysisBoard.AddVariation(move);
        boardComponent?.Update(AnalysisBoard.CurrentPosition, move);
        liveEvalComponent?.Update();
    }

    private void NodeClicked(chess.Analyze.MoveNode args)
    {
        AnalysisBoard.MoveToNode(args);
        liveEvalComponent?.Update();
    }

    private void KeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "ArrowLeft")
        {
            AnalysisBoard.MoveBackward();
            liveEvalComponent?.Update();
        }
        else if (args.Key == "ArrowRight")
        {
            AnalysisBoard.MoveForward();
            liveEvalComponent?.Update();
        }
        else if (args.Key == " " || args.Key == "Spacebar" || args.Key == "Space")
        {
            if (liveEvalComponent is null)
                return;

            if (!liveEvalComponent.IsRunning)
            {
                liveEvalComponent.StartAnalysis();
                return;
            }

            var bestMove = liveEvalComponent.GetBestMove();
            if (bestMove is not null)
            {
                ApplyMove(bestMove);
            }
        }
    }

    private void BestMovesReady(List<Move> args)
    {
        boardComponent?.AddBestMoveAnnotations(args);
    }

    private void ChartMoveClicked(int args)
    {
        var mainLine = GetMainLine();
        var index = args - 1;
        if (mainLine.Count > index)
        {
            var node = mainLine[index];
            NodeClicked(node);
        }
    }

    private List<pax.chess.Analyze.MoveNode> GetMainLine()
    {
        var current = AnalysisBoard.Root.MainLine;
        List<pax.chess.Analyze.MoveNode> mainLine = new();
        while (current != null)
        {
            mainLine.Add(current);
            current = current.MainLine;
        }
        return mainLine;
    }

    private void OpenImportModal()
    {
        pgnText = string.Empty;
        importError = null;
        showImportModal = true;
    }

    private void CloseImportModal()
    {
        showImportModal = false;
        importError = null;
    }

    private void OpenSaveModal()
    {
        saveName = string.Empty;
        saveError = null;
        showSaveModal = true;
    }

    private void CloseSaveModal()
    {
        showSaveModal = false;
        saveError = null;
    }

    private async Task SaveAnalysis()
    {
        try
        {
            await ChessBoardRepository.SaveAnalyzedGame(saveName, AnalysisBoard);
            showSaveModal = false;
            saveError = null;
        }
        catch (Exception ex)
        {
            saveError = ex.Message;
        }
    }

    private async Task LoadSavedList()
    {
        savedAnalyses.Clear();
        loadError = null;
        try
        {
            var list = await ChessBoardRepository.ListAnalyzedGames();
            savedAnalyses.AddRange(list);
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        selectedLoadId = savedAnalyses.FirstOrDefault()?.Id;
    }

    private async Task LoadSelectedAnalysis()
    {
        if (selectedLoadId is null)
            return;

        try
        {
            var board = await ChessBoardRepository.LoadAnalyzedGame(selectedLoadId.Value);
            if (board is null)
            {
                loadError = "Selected analysis not found.";
                return;
            }

            AnalysisBoard = board;
            showLoadModal = false;
            loadError = null;

            boardComponent?.Update(AnalysisBoard.CurrentPosition, null);
            liveEvalComponent?.Update();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
    }

    private async Task OpenLoadModal()
    {
        await LoadSavedList();
        showLoadModal = true;
    }

    private void CloseLoadModal()
    {
        showLoadModal = false;
        loadError = null;
    }

    private void ImportPgn()
    {
        try
        {
            var game = PgnSerializer.Parse(pgnText);
            AnalysisBoard = new pax.chess.Analyze.AnalysisBoard(game);
            showChart = false;
            showImportModal = false;
            importError = null;

            boardComponent?.Update(AnalysisBoard.CurrentPosition, null);
            liveEvalComponent?.Update();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            importError = $"Could not import PGN: {ex.Message}";
        }
    }

    private void ClampThinkTime()
    {
        if (thinkTimePerMoveMs < 100)
            thinkTimePerMoveMs = 100;
    }

    private Task AnnotationsChanged()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    private EngineGameSession? ActiveEngineGame => activeEngineGameId.HasValue
        ? engineGameSessions.FirstOrDefault(g => g.Id == activeEngineGameId.Value)
        : null;

    private async Task StartEngineGame()
    {
        var white = engineRunOptions.FirstOrDefault(o => o.Id == selectedWhiteEngineId)
            ?? engineRunOptions.FirstOrDefault();
        var black = engineRunOptions.FirstOrDefault(o => o.Id == selectedBlackEngineId)
            ?? engineRunOptions.FirstOrDefault();

        if (white is null || black is null)
            return;

        var startPosition = AnalysisBoard.CurrentPosition.Clone();
        var clock = new ChessClock(
            TimeSpan.FromMinutes(Math.Max(1, engineBaseMinutes)),
            TimeSpan.FromSeconds(Math.Max(0, engineIncrementSeconds)));

        var game = new ChessGame(startPosition, new GameMetadata(), clock);

        var whiteEngine = new UciEngine(white.BinaryPath);
        var blackEngine = new UciEngine(black.BinaryPath);
        var threads = Math.Max(1, Math.Max(white.Threads, black.Threads));

        var engineGame = new EngineGame(whiteEngine, blackEngine, game, threads);

        var session = new EngineGameSession
        {
            EngineGame = engineGame,
            Game = game,
            Clock = clock,
            WhiteEngine = !string.IsNullOrEmpty(white.Name) ? white.Name! : white.BinaryPath,
            BlackEngine = !string.IsNullOrEmpty(black.Name) ? black.Name! : black.BinaryPath,
            Name = $"Game {engineGameSessions.Count + 1}"
        };

        engineGame.MoveReady += (_, e) => OnEngineMoveReady(session, e);
        engineGame.GameFinished += (_, _) => OnEngineGameFinished(session);

        engineGameSessions.Add(session);
        activeEngineGameId = session.Id;
        activeTab = AnalysisTab.EngineGames;

        await engineGame.Start(clock);
        session.IsRunning = true;
        await InvokeAsync(StateHasChanged);
    }

    private void OnEngineMoveReady(EngineGameSession session, EngineMoveEventArgs e)
    {
        var lastMove = session.Game.Moves.LastOrDefault()?.Move;
        var sideToMove = session.Game.CurrentPosition.SideToMove;
        if (e.Eval != null)
        {
            if (sideToMove == PieceColor.White)
                session.WhiteEval = e.Eval;
            else
                session.BlackEval = e.Eval;
        }
        session.BoardComponent?.Update(session.Game.CurrentPosition, lastMove);
        InvokeAsync(StateHasChanged);
    }

    private void OnEngineGameFinished(EngineGameSession session)
    {
        session.IsRunning = false;
        session.Result = session.Game.Result?.ToString() ?? "Finished";
        InvokeAsync(StateHasChanged);
    }

    private void SelectEngineGame(Guid id)
    {
        activeEngineGameId = id;
    }

    private async Task StopEngineGame(EngineGameSession? session)
    {
        if (session is null || !session.IsRunning)
            return;

        try
        {
            await session.EngineGame.StopGame();
        }
        catch (OperationCanceledException)
        {
            // Expected when the engine loop is cancelled; safely ignore.
        }
        catch (Exception ex)
        {
            Console.WriteLine($"failed stopping game: {ex.Message}");
        }
        session.IsRunning = false;
        session.Result ??= "Stopped";
        await InvokeAsync(StateHasChanged);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        foreach (var game in engineGameSessions)
        {
            if (game.ClockComponent != null)
            {
                game.Clock.AttachDisplay(game.ClockComponent);
                game.ClockComponent.OnClockUpdated(game.Clock.WhiteTime, game.Clock.BlackTime, game.Game.CurrentPosition.SideToMove);
                game.DisplayAttached = true;
            }
            else
            {
                game.DisplayAttached = false;
            }
        }

        return base.OnAfterRenderAsync(firstRender);
    }

    public async ValueTask DisposeAsync()
    {
        foreach (var session in engineGameSessions)
        {
            await session.EngineGame.DisposeAsync();
        }
        engineMatchBatch.MatchUpdated -= OnEngineMatchUpdated;
        engineMatchBatch.BatchFinished -= OnEngineMatchBatchFinished;
        await engineMatchBatch.DisposeAsync();
    }
    private void ShowAnalysis(MouseEventArgs args)
    {
        showChart = !showChart;
        if (showChart)
        {
            _ = gameAnalisisComponent?.Analyse();
        }
        else
        {
        }
    }

    private void OpenEngineSettingsModal()
    {
        showEngineSettingsModal = true;
    }

    private void CloseEngineSettingsModal()
    {
        showEngineSettingsModal = false;
    }

    private async Task StoreEngineRunOptions(List<EngineRunOptions> options)
    {
        await ChessBoardRepository.StoreEngineRunOptions(options);
        engineRunOptions = options;
        selectedWhiteEngineId = engineRunOptions.FirstOrDefault()?.Id ?? Guid.Empty;
        selectedBlackEngineId = engineRunOptions.Skip(1).FirstOrDefault()?.Id
            ?? engineRunOptions.FirstOrDefault()?.Id ?? Guid.Empty;
        liveEvalComponent?.RefreshEngineOptions();
        UpdateEngineMatchConcurrency();
        StateHasChanged();
    }

    private void UpdateEngineMatchConcurrency()
    {
        var white = engineRunOptions.FirstOrDefault(o => o.Id == selectedWhiteEngineId)
            ?? engineRunOptions.FirstOrDefault();
        var black = engineRunOptions.FirstOrDefault(o => o.Id == selectedBlackEngineId)
            ?? engineRunOptions.FirstOrDefault();

        if (white is null || black is null)
        {
            engineMatchMaxConcurrentDisplay = 1;
            return;
        }

        engineMatchMaxConcurrentDisplay = EngineMatchBatch.ComputeMaxConcurrent(white, black);
    }

    private int engineMatchWhiteWins => engineMatchResults.Count(r => r.Result == GameResult.WhiteWin);
    private int engineMatchBlackWins => engineMatchResults.Count(r => r.Result == GameResult.BlackWin);
    private int engineMatchDraws => engineMatchResults.Count(r => r.Result == GameResult.Draw);
    private int engineMatchRunningCount => engineMatchResults.Count(r => r.Status == EngineMatchStatus.Running);

    private async Task StartEngineMatches()
    {
        if (engineMatchesRunning)
            return;

        var white = engineRunOptions.FirstOrDefault(o => o.Id == selectedWhiteEngineId)
            ?? engineRunOptions.FirstOrDefault();
        var black = engineRunOptions.FirstOrDefault(o => o.Id == selectedBlackEngineId)
            ?? engineRunOptions.FirstOrDefault();

        if (white is null || black is null)
            return;

        UpdateEngineMatchConcurrency();
        engineMatchCount = Math.Max(1, engineMatchCount);
        engineMatchViewBoard = null;
        engineMatchViewLabel = string.Empty;

        var request = new EngineMatchBatchRequest(
            AnalysisBoard.CurrentPosition.Clone(),
            white,
            black,
            engineMatchCount,
            TimeSpan.FromMinutes(Math.Max(1, engineBaseMinutes)),
            TimeSpan.FromSeconds(Math.Max(0, engineIncrementSeconds)),
            engineMatchReverseEngines);

        await engineMatchBatch.RunAsync(request);
    }

    private async Task StopEngineMatches()
    {
        await engineMatchBatch.StopAsync();
    }

    private void OnEngineMatchUpdated(object? sender, EngineMatchSummary summary)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnEngineMatchBatchFinished(object? sender, EventArgs args)
    {
        InvokeAsync(StateHasChanged);
    }

    private void ViewEngineMatch(EngineMatchSummary match)
    {
        if (match.Game is null)
            return;

        engineMatchViewBoard = new AnalysisBoard(match.Game);
        engineMatchViewLabel = $"{match.WhiteEngine} vs {match.BlackEngine} (#{match.Index})";
        engineMatchBoardRef?.Update(engineMatchViewBoard.CurrentPosition, null);
    }

    private void ClearEngineMatchView()
    {
        engineMatchViewBoard = null;
        engineMatchViewLabel = string.Empty;
    }

    private void EngineMatchNodeClicked(chess.Analyze.MoveNode node)
    {
        if (engineMatchViewBoard is null)
            return;
        engineMatchViewBoard.MoveToNode(node);
        engineMatchBoardRef?.Update(engineMatchViewBoard.CurrentPosition, null);
    }

    private void EngineMatchBack()
    {
        if (engineMatchViewBoard is null)
            return;
        engineMatchViewBoard.MoveBackward();
        engineMatchBoardRef?.Update(engineMatchViewBoard.CurrentPosition, null);
    }

    private void EngineMatchForward()
    {
        if (engineMatchViewBoard is null)
            return;
        engineMatchViewBoard.MoveForward();
        engineMatchBoardRef?.Update(engineMatchViewBoard.CurrentPosition, null);
    }
}
