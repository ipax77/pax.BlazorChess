@using pax.chess
@using pax.uciChessEngine

@if (Session is not null)
{
    <div class="card bg-dark text-light border-secondary">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <div class="fw-bold">White: @Session.WhiteEngine</div>
                <div class="fw-bold">Black: @Session.BlackEngine</div>
                <div class="mt-1 d-flex gap-2 small">
                    <span class="badge bg-light text-dark">W: @FormatEval(Session.WhiteEval)</span>
                    <span class="badge bg-secondary">B: @FormatEval(Session.BlackEval)</span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (Session.IsRunning)
                {
                    <span class="badge bg-success">Running</span>
                }
                else
                {
                    <span class="badge bg-secondary">Stopped</span>
                }
                <button class="btn btn-sm btn-outline-light" @onclick="OnStop">Stop</button>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-6">
                    <BoardComponent @ref="Session.BoardComponent"
                                    Position="Session.Game.CurrentPosition"
                                    OnMovePlayed="IgnoreMove" />
                </div>
                <div class="col-6">
                    <ClockComponent @ref="Session.ClockComponent" />
                    <div class="mt-3 small text-secondary">Side to move: @Session.Game.CurrentPosition.SideToMove</div>
                    <div class="small text-secondary">Moves played: @Session.Game.Moves.Count</div>
                    @if (!string.IsNullOrEmpty(Session.Result))
                    {
                        <div class="mt-2">Result: @Session.Result</div>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-secondary">No engine game selected.</div>
}

@code {
    [Parameter]
    public EngineGameSession? Session { get; set; }

    [Parameter]
    public EventCallback OnStopRequested { get; set; }

    private Task IgnoreMove(Move move) => Task.CompletedTask;

    private Task OnStop()
    {
        return OnStopRequested.HasDelegate ? OnStopRequested.InvokeAsync() : Task.CompletedTask;
    }

    private static string FormatEval(Eval? eval)
    {
        if (eval == null)
            return "…";
        if (eval.Mate.HasValue && eval.Mate.Value != 0)
            return $"M{eval.Mate.Value}";
        return (eval.Score / 100.0).ToString("N2");
    }
}
