@using System.Collections.Concurrent
@using pax.BlazorChartJs
@using pax.chess
@using pax.chess.Analyze
@using pax.uciChessEngine
@using pax.uciChessEngine.EngineServices
@implements IDisposable

<div class="position-relative">
    <div class="@(isAnalysing ? "opacity-50" : "opacity-100") transition-opacity">
        <ChartComponent ChartJsConfig="chartJsConfig" OnEventTriggered="ChartEventTriggerd" />
    </div>

    @if (isAnalysing)
    {
        <div class="position-absolute top-50 start-50 translate-middle d-flex align-items-center bg-white border rounded-pill px-3 py-2 shadow-sm">
            <div class="spinner-border spinner-border-sm text-primary me-2" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <small class="fw-bold text-secondary">Engine Analyzing...</small>
        </div>
    }
</div>

@if (evals.Any())
{
    <style>
        .clickable-badge {
            cursor: pointer;
            transition: transform 0.1s;
        }

            .clickable-badge:hover {
                transform: scale(1.1);
                filter: brightness(1.2);
            }

            .clickable-badge:active {
                transform: scale(0.95);
            }
    </style>

    <div class="mt-3 p-3 bg-dark text-white rounded shadow-sm border border-secondary">
        <h5 class="text-center mb-3 text-warning">Analysis Summary</h5>
        <div class="row">
            <div class="col-6 border-end border-secondary px-4">
                <h6 class="text-light border-bottom border-secondary pb-1 mb-3">White</h6>
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex justify-content-between align-items-center small"><span>Blunders:</span> <span class="badge bg-danger rounded-pill clickable-badge" @onclick='() => JumpToCategoryMove("white", "blunder")'>@whiteSummary.Blunders</span></div>
                    <div class="d-flex justify-content-between align-items-center small"><span>Mistakes:</span> <span class="badge bg-warning text-dark rounded-pill clickable-badge" @onclick='() => JumpToCategoryMove("white", "mistake")'>@whiteSummary.Mistakes</span></div>
                    <div class="d-flex justify-content-between align-items-center small"><span>Inaccuracies:</span> <span class="badge bg-info text-dark rounded-pill clickable-badge" @onclick='() => JumpToCategoryMove("white", "inaccuracy")'>@whiteSummary.Inaccuracies</span></div>
                    <div class="d-flex justify-content-between align-items-center small"><span>Club House:</span> <span class="badge bg-success rounded-pill clickable-badge" @onclick='() => JumpToCategoryMove("white", "clubhouse")'>@whiteSummary.ClubHouseMoves</span></div>
                    <div class="d-flex justify-content-between align-items-center small"><span>Best:</span> <span class="badge bg-primary rounded-pill clickable-badge" @onclick='() => JumpToCategoryMove("white", "best")'>@whiteSummary.BestMoves</span></div>
                </div>
            </div>
            <div class="col-6 px-4">
                <h6 class="text-light border-bottom border-secondary pb-1 mb-3">Black</h6>
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex justify-content-between align-items-center small"><span>Blunders:</span> <span class="badge bg-danger rounded-pill clickable-badge" @onclick='() => JumpToCategoryMove("black", "blunder")'>@blackSummary.Blunders</span></div>
                    <div class="d-flex justify-content-between align-items-center small"><span>Mistakes:</span> <span class="badge bg-warning text-dark rounded-pill clickable-badge" @onclick='() => JumpToCategoryMove("black", "mistake")'>@blackSummary.Mistakes</span></div>
                    <div class="d-flex justify-content-between align-items-center small"><span>Inaccuracies:</span> <span class="badge bg-info text-dark rounded-pill clickable-badge" @onclick='() => JumpToCategoryMove("black", "inaccuracy")'>@blackSummary.Inaccuracies</span></div>
                    <div class="d-flex justify-content-between align-items-center small"><span>Club House:</span> <span class="badge bg-success rounded-pill clickable-badge" @onclick='() => JumpToCategoryMove("black", "clubhouse")'>@blackSummary.ClubHouseMoves</span></div>
                    <div class="d-flex justify-content-between align-items-center small"><span>Best:</span> <span class="badge bg-primary rounded-pill clickable-badge" @onclick='() => JumpToCategoryMove("black", "best")'>@blackSummary.BestMoves</span></div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public required ChessGame ChessGame { get; set; }

    [Parameter, EditorRequired]
    public required EngineRunOptions EngineRunOptions { get; set; }

    [Parameter]
    public EventCallback<int> OnMoveClicked { get; set; }

    CancellationTokenSource cts = new();

    ConcurrentDictionary<int, Eval> evals = [];

    ChartJsConfig chartJsConfig = null!;

    private bool chartReady;
    private bool isAnalysing;

    private AnalysisSummary whiteSummary = new();
    private AnalysisSummary blackSummary = new();

    private string? lastCategoryClicked;
    private int lastCategoryIndex;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        chartJsConfig = GetChartJsConfig();
        List<string> labels = ChessGame.Moves
            .Select((s, i) => i % 2 == 0 ? "" : ((i + 1) / 2).ToString())
            .ToList();

        if (ChessGame.Conclusion != null &&
            (ChessGame.Conclusion.Termination == GameTermination.Checkmate || ChessGame.Conclusion.Termination == GameTermination.Stalemate))
        {
            labels.Remove(labels.Last());
        }
        chartJsConfig.SetLabels(labels);
        var lineDataSet = chartJsConfig.Data.Datasets.FirstOrDefault() as LineDataset;
        if (lineDataSet is not null)
        {
            lineDataSet.Data = labels.Select(s => 0 as object).ToList();
        }
        _ = Analyse();
    }

    private async Task StartChartRefreshLoop()
    {
        isAnalysing = true;
        while (isAnalysing && !cts.IsCancellationRequested)
        {
            await Task.Delay(500);
            RefreshChartData();
        }
    }

    private void RefreshChartData()
    {
        if (!chartReady) return;

        var lineDataSet = chartJsConfig.Data.Datasets.FirstOrDefault() as LineDataset;
        if (lineDataSet?.Data == null) return;

        bool hasChanges = false;

        foreach (var kvp in evals)
        {
            int index = kvp.Key - 1;
            if (index >= 0 && index < lineDataSet.Data.Count)
            {
                var newScore = kvp.Value.ChartScore;
                if (!lineDataSet.Data[index].Equals(newScore))
                {
                    lineDataSet.Data[index] = newScore;
                    hasChanges = true;
                }
            }
        }

        if (hasChanges)
        {
            CalculateSummary();
            chartJsConfig.UpdateDatasetSmooth(lineDataSet);
        }
    }

    private void ChartEventTriggerd(ChartJsEvent args)
    {
        if (args is ChartJsInitEvent)
        {
            chartReady = true;
        }
        else if (args is ChartJsLabelClickEvent clickEvent)
        {
            OnMoveClicked.InvokeAsync((int)clickEvent.DataX);
        }
    }

    private async Task Analyse()
    {
        var provider = EngineService.GetEngineSessionProvider(EngineRunOptions);
        var gameAnalysis = new GameAnalysis(provider, ChessGame);

        _ = StartChartRefreshLoop();

        try
        {
            await foreach (var result in gameAnalysis.AnalyseGameStream(cts.Token))
            {
                if (result.Eval == null) continue;
                evals.AddOrUpdate(result.MoveNumber, result.Eval, (k, v) => result.Eval);
            }
        }
        finally
        {
            isAnalysing = false;
            CalculateSummary();
            RefreshChartData();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CalculateSummary()
    {
        whiteSummary = new();
        blackSummary = new();

        double prevScore = 30; // 0.3 CP starting

        var sortedKeys = evals.Keys.OrderBy(k => k).ToList();

        foreach (var key in sortedKeys)
        {
            if (evals.TryGetValue(key, out var eval))
            {
                double currentScore = GetScore(eval);
                double loss;

                if (key % 2 != 0) // White's move
                {
                    loss = prevScore - currentScore;
                    UpdateSummary(whiteSummary, loss, key);
                }
                else // Black's move
                {
                    loss = currentScore - prevScore;
                    UpdateSummary(blackSummary, loss, key);
                }
                prevScore = currentScore;
            }
        }
    }

    private double GetScore(Eval eval)
    {
        if (eval.Mate.HasValue && eval.Mate != 0)
        {
            int mate = eval.Mate.Value;
            return mate > 0 ? 10000 - mate : -10000 - mate;
        }
        return (double)eval.Score;
    }

    private void UpdateSummary(AnalysisSummary summary, double loss, int moveNumber)
    {
        if (loss > 200) summary.BlunderMoves.Add(moveNumber);
        else if (loss > 100) summary.MistakeMoves.Add(moveNumber);
        else if (loss > 50) summary.InaccuracyMoves.Add(moveNumber);
        else if (loss > 20) summary.ClubHouseMovesList.Add(moveNumber);
        else summary.BestMovesList.Add(moveNumber);
    }

    private void JumpToCategoryMove(string player, string category)
    {
        var summary = player == "white" ? whiteSummary : blackSummary;
        List<int> moves = category switch
        {
            "blunder" => summary.BlunderMoves,
            "mistake" => summary.MistakeMoves,
            "inaccuracy" => summary.InaccuracyMoves,
            "clubhouse" => summary.ClubHouseMovesList,
            "best" => summary.BestMovesList,
            _ => new()
        };

        if (!moves.Any()) return;

        string key = $"{player}_{category}";
        if (lastCategoryClicked == key)
        {
            lastCategoryIndex = (lastCategoryIndex + 1) % moves.Count;
        }
        else
        {
            lastCategoryClicked = key;
            lastCategoryIndex = 0;
        }

        OnMoveClicked.InvokeAsync(moves[lastCategoryIndex]);
    }

    private class AnalysisSummary
    {
        public List<int> BlunderMoves { get; } = new();
        public List<int> MistakeMoves { get; } = new();
        public List<int> InaccuracyMoves { get; } = new();
        public List<int> ClubHouseMovesList { get; } = new();
        public List<int> BestMovesList { get; } = new();

        public int Blunders => BlunderMoves.Count;
        public int Mistakes => MistakeMoves.Count;
        public int Inaccuracies => InaccuracyMoves.Count;
        public int ClubHouseMoves => ClubHouseMovesList.Count;
        public int BestMoves => BestMovesList.Count;
    }

    private void UpdateChart(int moveNumber, int score)
    {
        var lineDataSet = chartJsConfig.Data.Datasets.FirstOrDefault() as LineDataset;

        if (lineDataSet is null)
        {
            return;
        }
        int index = moveNumber - 1;
        if (index >= 0 && index < lineDataSet.Data.Count)
        {
            lineDataSet.Data[index] = score;

            if (chartReady)
            {
                chartJsConfig.UpdateDatasetSmooth(lineDataSet);
            }
        }
    }

    private ChartJsConfig GetChartJsConfig()
    {
        return new()
        {
            Type = ChartType.line,
            Data = new ChartJsData()
            {
                Labels = new List<string>(),
                Datasets = new List<ChartJsDataset>()
                {
                    new LineDataset()
                    {
                        Label = "Rating",
                        BackgroundColor = "white",
                        BorderColor = "#ffffff",
                        Fill = new
                            {
                                target = "origin",
                                above = "rgb(255, 255, 255, 0.6)",
                                below = "rgb(0, 0, 0, 0.6)"
                            },
                        PointBackgroundColor = new IndexableOption<string>("white"),
                        PointBorderColor = new IndexableOption<string>("yellow"),
                        PointRadius = new IndexableOption<double>(3),
                        PointBorderWidth = new IndexableOption<double>(2),
                        PointHitRadius = new IndexableOption<double>(5),
                        Tension = 0.4
                    }
                }
            },
            Options = new ChartJsOptions()
            {
                Responsive = true,
                OnClickEvent = true,
                Plugins = new Plugins()
                {
                    Legend = new Legend()
                    {
                        Position = "top"
                    },
                    Title = new Title()
                    {
                        Display = true,
                        Text = new IndexableOption<string>("Game Evaluation"),
                        Color = "yellow",
                        Font = new Font()
                        {
                            Size = 16
                        }
                    },
                    ArbitraryLines = new List<ArbitraryLineConfig>()
                    {
                        new ArbitraryLineConfig()
                        {
                            ArbitraryLineColor = "blue",
                            XPosition = 0,
                            XWidth = 3,
                            Text = "Current"
                        }
                    }
                },
                Scales = new ChartJsOptionsScales()
                {
                    X = new LinearAxis()
                    {
                        Display = true,
                        Title = new Title()
                        {
                            Display = true,
                            Text = new IndexableOption<string>("Moves"),
                            Color = "yellow"
                        },
                        Ticks = new LinearAxisTick()
                        {
                            Color = "yellow",
                        },
                        Grid = new ChartJsGrid()
                        {
                            Color = "grey"
                        }
                    },
                    Y = new LinearAxis()
                    {
                        Display = true,
                        BeginAtZero = true,
                        Title = new Title()
                        {
                            Display = true,
                            Text = new IndexableOption<string>("Evaluation"),
                            Color = "yellow"
                        },
                        Ticks = new LinearAxisTick()
                        {
                            Color = "yellow"
                        },
                        Grid = new ChartJsGrid()
                        {
                            Color = "grey"
                        }
                    }
                }
            }
        };
    }

    public void Dispose()
    {
        isAnalysing = false;
        cts.Cancel();
        cts.Dispose();
    }
}
