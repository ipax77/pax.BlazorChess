@using pax.BlazorChartJs
@using System.Globalization
@using pax.chess
@using pax.chess.Analyze
@using pax.chess.Extensions
@using pax.uciChessEngine
@using pax.uciChessEngine.EngineServices
@implements IDisposable

<div class="game-analysis">
    <div class="game-analysis-chart-shell @(isAnalysing ? "is-running" : "")">
        <div class="game-analysis-chart">
            <ChartComponent ChartJsConfig="chartJsConfig" OnEventTriggered="ChartEventTriggerd" />
        </div>

        @if (isAnalysing)
        {
            <div class="game-analysis-overlay" aria-live="polite">
                <div class="game-analysis-spinner" aria-hidden="true"></div>
                <div>
                    <strong>Engine analysing</strong>
                    <span>@AnalysedMoveCount / @MoveCount moves</span>
                </div>
            </div>
        }
    </div>

    <aside class="game-analysis-summary" aria-label="Analysis summary">
        @if (MoveCount == 0)
        {
            <div class="analysis-empty">Load or play a game before running full-game analysis.</div>
        }
        else if (!HasEvaluations)
        {
            <div class="analysis-empty">Run analysis to classify moves and inspect the evaluation curve.</div>
        }
        else
        {
            <div class="summary-side">
                <span>White</span>
                @SummaryButton("Blunders", whiteSummary.BlunderMoves, "white", "blunder", "danger")
                @SummaryButton("Mistakes", whiteSummary.MistakeMoves, "white", "mistake", "warn")
                @SummaryButton("Inaccuracies", whiteSummary.InaccuracyMoves, "white", "inaccuracy", "info")
                @SummaryButton("Good", whiteSummary.ClubHouseMovesList, "white", "clubhouse", "ok")
                @SummaryButton("Best", whiteSummary.BestMovesList, "white", "best", "best")
            </div>
            <div class="summary-side">
                <span>Black</span>
                @SummaryButton("Blunders", blackSummary.BlunderMoves, "black", "blunder", "danger")
                @SummaryButton("Mistakes", blackSummary.MistakeMoves, "black", "mistake", "warn")
                @SummaryButton("Inaccuracies", blackSummary.InaccuracyMoves, "black", "inaccuracy", "info")
                @SummaryButton("Good", blackSummary.ClubHouseMovesList, "black", "clubhouse", "ok")
                @SummaryButton("Best", blackSummary.BestMovesList, "black", "best", "best")
            </div>
        }
    </aside>
</div>

@code {
    private const int ChartRefreshMs = 350;
    private const string EvaluationDatasetId = "game-analysis-evaluation";

    [Parameter, EditorRequired]
    public required ChessGame ChessGame { get; set; }

    [Parameter]
    public AnalysisBoard? AnalysisBoard { get; set; }

    [Parameter, EditorRequired]
    public required EngineRunOptions EngineRunOptions { get; set; }

    [Parameter]
    public EventCallback<int> OnMoveClicked { get; set; }

    [Parameter]
    public EventCallback OnAnnotationsChanged { get; set; }

    [Parameter]
    public int ThinkTimePerMoveMs { get; set; } = 1000;

    [Parameter]
    public int AnalysisThreads { get; set; }

    private readonly object evalLock = new();
    private CancellationTokenSource cts = new();
    private Eval?[] evals = [];
    private List<string> chartLabels = [];
    private List<object> chartData = [];
    private List<AnalysisTooltipPoint> tooltipPoints = [];
    private AnalysisEvaluationDataset evaluationDataset = null!;
    private ChartJsConfig chartJsConfig = null!;
    private bool chartReady;
    private bool isAnalysing;
    private bool chartDirty;
    private bool summaryDirty;
    private int analysedMoveCount;
    private int configuredMoveCount = -1;

    private AnalysisSummary whiteSummary = new();
    private AnalysisSummary blackSummary = new();
    private string? lastCategoryClicked;
    private int lastCategoryIndex;

    private int MoveCount => ChessGame.Moves.Count;
    private int AnalysedMoveCount => analysedMoveCount;
    private bool HasEvaluations => analysedMoveCount > 0;

    protected override void OnInitialized()
    {
        chartJsConfig = GetChartJsConfig();
        ConfigureChartForCurrentGame();
    }

    protected override void OnParametersSet()
    {
        if (configuredMoveCount != MoveCount)
            ConfigureChartForCurrentGame();
    }

    public async Task Analyse()
    {
        if (isAnalysing || MoveCount == 0)
            return;

        ResetAnalysisState();
        isAnalysing = true;
        var completedNaturally = false;
        await InvokeAsync(StateHasChanged);

        _ = StartChartRefreshLoop();

        var provider = EngineService.GetEngineSessionProvider(EngineRunOptions);
        var requestedThreads = AnalysisThreads > 0
            ? AnalysisThreads
            : EngineRunOptions.Threads > 0
                ? EngineRunOptions.Threads
                : 8;
        var threads = Math.Clamp(requestedThreads, 1, Math.Max(1, Environment.ProcessorCount));
        await using var gameAnalysis = new GameAnalysis(provider, ChessGame, threads, Math.Max(100, ThinkTimePerMoveMs));

        try
        {
            await foreach (var result in gameAnalysis.AnalyseGameStream(cts.Token))
            {
                if (result.Eval is null)
                    continue;

                var index = result.MoveNumber - 1;
                if (index < 0 || index >= evals.Length)
                    continue;

                lock (evalLock)
                {
                    evals[index] = result.Eval;
                    analysedMoveCount++;
                    chartDirty = true;
                    summaryDirty = true;
                }
            }

            completedNaturally = !cts.IsCancellationRequested;
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            isAnalysing = false;
            RefreshChartData(forceSummary: true);

            if (completedNaturally && !cts.IsCancellationRequested && AddCategoryVariations())
                await OnAnnotationsChanged.InvokeAsync();

            await InvokeAsync(StateHasChanged);
        }
    }

    public void StopAnalysis()
    {
        if (!isAnalysing || cts.IsCancellationRequested)
            return;

        cts.Cancel();
    }

    private async Task StartChartRefreshLoop()
    {
        try
        {
            while (isAnalysing && !cts.IsCancellationRequested)
            {
                await Task.Delay(ChartRefreshMs, cts.Token);
                RefreshChartData(forceSummary: false);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void ConfigureChartForCurrentGame()
    {
        configuredMoveCount = MoveCount;
        evals = new Eval?[MoveCount];
        analysedMoveCount = 0;
        whiteSummary = new();
        blackSummary = new();
        lastCategoryClicked = null;
        lastCategoryIndex = 0;
        chartDirty = false;
        summaryDirty = false;

        chartLabels = CreateChartLabels(MoveCount);
        chartData = CreatePendingChartData(MoveCount);
        tooltipPoints = CreatePendingTooltipPoints(MoveCount);
        evaluationDataset = CreateEvaluationDataset(chartData, tooltipPoints);
        chartJsConfig.SetDatasetsSmooth([evaluationDataset], chartLabels);
    }

    private void ResetAnalysisState()
    {
        if (cts.IsCancellationRequested)
        {
            cts.Dispose();
            cts = new CancellationTokenSource();
        }

        EnsureChartStorage();
        lock (evalLock)
        {
            Array.Clear(evals);
            ResetChartData();
            analysedMoveCount = 0;
            whiteSummary = new();
            blackSummary = new();
            lastCategoryClicked = null;
            lastCategoryIndex = 0;
            chartDirty = true;
            summaryDirty = true;
        }
    }

    private void RefreshChartData(bool forceSummary)
    {
        if (!chartReady)
            return;

        EnsureChartStorage();
        if (evaluationDataset.Data is null)
            return;

        bool shouldUpdateChart;
        bool shouldUpdateSummary;

        lock (evalLock)
        {
            shouldUpdateChart = chartDirty;
            shouldUpdateSummary = forceSummary || summaryDirty;
            if (!shouldUpdateChart && !shouldUpdateSummary)
                return;

            if (shouldUpdateChart)
                RefreshChartDataFromEvaluations();

            if (shouldUpdateSummary)
                CalculateSummary();

            chartDirty = false;
            summaryDirty = false;
        }

        if (shouldUpdateChart)
            chartJsConfig.SetDatasetsSmooth([evaluationDataset], chartLabels);
    }

    private void ChartEventTriggerd(ChartJsEvent args)
    {
        if (args is ChartJsInitEvent)
        {
            chartReady = true;
            RefreshChartData(forceSummary: true);
        }
        else if (args is ChartJsLabelClickEvent clickEvent)
        {
            OnMoveClicked.InvokeAsync((int)clickEvent.DataX);
        }
    }

    private void RefreshChartDataFromEvaluations()
    {
        for (var i = 0; i < evals.Length && i < chartData.Count; i++)
        {
            var eval = evals[i];
            if (eval is null)
                continue;

            var displayScore = AnalysisEvaluationMetrics.GetDisplayScore(eval.Score, eval.Mate);
            chartData[i] = displayScore;
            tooltipPoints[i] = CreateTooltipPoint(i + 1, eval, displayScore);
        }
    }

    private void CalculateSummary()
    {
        var white = new AnalysisSummary();
        var black = new AnalysisSummary();
        double previousWinningChance = 50;

        for (var i = 0; i < evals.Length; i++)
        {
            var eval = evals[i];
            if (eval is null)
                continue;

            var moveNumber = i + 1;
            var currentWinningChance = AnalysisEvaluationMetrics.GetWinningChance(eval.Score, eval.Mate);
            double loss;

            if (moveNumber % 2 != 0)
            {
                loss = previousWinningChance - currentWinningChance;
                UpdateSummary(white, loss, moveNumber);
            }
            else
            {
                loss = currentWinningChance - previousWinningChance;
                UpdateSummary(black, loss, moveNumber);
            }

            previousWinningChance = currentWinningChance;
        }

        whiteSummary = white;
        blackSummary = black;
    }

    private bool AddCategoryVariations()
    {
        if (AnalysisBoard is null)
            return false;

        HashSet<int> criticalMoves = new(whiteSummary.BlunderMoves);
        criticalMoves.UnionWith(whiteSummary.MistakeMoves);
        criticalMoves.UnionWith(blackSummary.BlunderMoves);
        criticalMoves.UnionWith(blackSummary.MistakeMoves);

        var changed = false;
        foreach (var move in criticalMoves)
        {
            var eval = move > 0 && move <= evals.Length ? evals[move - 1] : null;
            if (eval is not null)
            {
                var label = GetCategoryLabel(move);
                changed |= AddVariationToAnalysisBoard(move, eval, label);
            }
        }

        return changed;
    }

    private string? GetCategoryLabel(int moveNumber)
    {
        if (whiteSummary.BlunderMoves.Contains(moveNumber)) return "White blunder";
        if (whiteSummary.MistakeMoves.Contains(moveNumber)) return "White mistake";
        if (blackSummary.BlunderMoves.Contains(moveNumber)) return "Black blunder";
        if (blackSummary.MistakeMoves.Contains(moveNumber)) return "Black mistake";
        return null;
    }

    private bool AddVariationToAnalysisBoard(int moveNumber, Eval eval, string? label)
    {
        if (AnalysisBoard is null || eval.PvInfo?.Moves is null || eval.PvInfo.Moves.Count == 0)
            return false;

        if (moveNumber >= MoveCount)
            return false;

        var node = GetMainLineNode(moveNumber);
        if (node is null)
            return false;

        if (PvStartsWithMainLine(node, eval.PvInfo.Moves[0]))
            return false;

        try
        {
            AnalysisBoard.AddVariation(node, eval.PvInfo);

            var firstMoveUci = eval.PvInfo.Moves.First();
            var firstNode = node.Children
                .FirstOrDefault(c => c.Move is not null && string.Equals(Uci.GetUci(c.Move), firstMoveUci, StringComparison.Ordinal));
            if (firstNode is not null)
            {
                firstNode.Note = label;
                firstNode.Evaluation = eval.Score;
                firstNode.Depth = eval.PvInfo.Depth;
            }

            return true;
        }
        catch
        {
            return false;
        }
    }

    private static bool PvStartsWithMainLine(MoveNode node, string firstMoveUci)
        => node.MainLine?.Move is not null
            && string.Equals(Uci.GetUci(node.MainLine.Move), firstMoveUci, StringComparison.Ordinal);

    private MoveNode? GetMainLineNode(int moveNumber)
    {
        if (AnalysisBoard is null || moveNumber <= 0)
            return null;

        var node = AnalysisBoard.Root.MainLine;
        var current = 1;
        while (node is not null && current < moveNumber)
        {
            node = node.MainLine;
            current++;
        }

        return node;
    }

    private static void UpdateSummary(AnalysisSummary summary, double loss, int moveNumber)
    {
        switch (AnalysisEvaluationMetrics.ClassifyLoss(loss))
        {
            case AnalysisMoveQuality.Blunder:
                summary.BlunderMoves.Add(moveNumber);
                break;
            case AnalysisMoveQuality.Mistake:
                summary.MistakeMoves.Add(moveNumber);
                break;
            case AnalysisMoveQuality.Inaccuracy:
                summary.InaccuracyMoves.Add(moveNumber);
                break;
            case AnalysisMoveQuality.Good:
                summary.ClubHouseMovesList.Add(moveNumber);
                break;
            default:
                summary.BestMovesList.Add(moveNumber);
                break;
        }
    }

    private void JumpToCategoryMove(string player, string category)
    {
        var summary = player == "white" ? whiteSummary : blackSummary;
        var moves = category switch
        {
            "blunder" => summary.BlunderMoves,
            "mistake" => summary.MistakeMoves,
            "inaccuracy" => summary.InaccuracyMoves,
            "clubhouse" => summary.ClubHouseMovesList,
            "best" => summary.BestMovesList,
            _ => []
        };

        if (moves.Count == 0)
            return;

        var key = $"{player}_{category}";
        if (lastCategoryClicked == key)
            lastCategoryIndex = (lastCategoryIndex + 1) % moves.Count;
        else
        {
            lastCategoryClicked = key;
            lastCategoryIndex = 0;
        }

        OnMoveClicked.InvokeAsync(moves[lastCategoryIndex]);
    }

    private RenderFragment SummaryButton(
        string label,
        IReadOnlyCollection<int> moves,
        string player,
        string category,
        string tone)
        => @<button type="button"
                    class="summary-button @tone"
                    disabled="@(moves.Count == 0)"
                    title="@($"{label}: {moves.Count}")"
                    @onclick="() => JumpToCategoryMove(player, category)">
                <span>@label</span>
                <strong>@moves.Count</strong>
            </button>;

    private sealed class AnalysisSummary
    {
        public List<int> BlunderMoves { get; } = [];
        public List<int> MistakeMoves { get; } = [];
        public List<int> InaccuracyMoves { get; } = [];
        public List<int> ClubHouseMovesList { get; } = [];
        public List<int> BestMovesList { get; } = [];
    }

    private void EnsureChartStorage()
    {
        if (evaluationDataset is not null
            && chartData.Count == MoveCount
            && tooltipPoints.Count == MoveCount
            && chartLabels.Count == MoveCount)
        {
            return;
        }

        chartLabels = CreateChartLabels(MoveCount);
        chartData = CreatePendingChartData(MoveCount);
        tooltipPoints = CreatePendingTooltipPoints(MoveCount);
        evaluationDataset = CreateEvaluationDataset(chartData, tooltipPoints);
    }

    private void ResetChartData()
    {
        for (var i = 0; i < chartData.Count; i++)
        {
            chartData[i] = null!;
            tooltipPoints[i] = CreatePendingTooltipPoint(i + 1);
        }
    }

    private static List<string> CreateChartLabels(int moveCount)
    {
        List<string> labels = new(moveCount);
        for (var i = 0; i < moveCount; i++)
            labels.Add(i % 2 == 0 ? string.Empty : ((i + 1) / 2).ToString(CultureInfo.InvariantCulture));

        return labels;
    }

    private static List<object> CreatePendingChartData(int moveCount)
    {
        List<object> data = new(moveCount);
        for (var i = 0; i < moveCount; i++)
            data.Add(null!);

        return data;
    }

    private static List<AnalysisTooltipPoint> CreatePendingTooltipPoints(int moveCount)
    {
        List<AnalysisTooltipPoint> points = new(moveCount);
        for (var i = 0; i < moveCount; i++)
            points.Add(CreatePendingTooltipPoint(i + 1));

        return points;
    }

    private static AnalysisEvaluationDataset CreateEvaluationDataset(
        List<object> data,
        List<AnalysisTooltipPoint> tooltipPoints)
        => new()
        {
            Id = EvaluationDatasetId,
            Label = "Evaluation",
            Data = data,
            TooltipPoints = tooltipPoints,
            BackgroundColor = "rgba(226, 232, 240, 0.2)",
            BorderColor = "#9fd169",
            Fill = new
            {
                target = "origin",
                above = "rgba(159, 209, 105, 0.28)",
                below = "rgba(218, 93, 75, 0.24)"
            },
            PointBackgroundColor = new IndexableOption<string>("#f4f7ef"),
            PointBorderColor = new IndexableOption<string>("#1d211a"),
            PointRadius = new IndexableOption<double>(2.5),
            PointBorderWidth = new IndexableOption<double>(1.5),
            PointHitRadius = new IndexableOption<double>(8),
            SpanGaps = true,
            Tension = 0.32
        };

    private static AnalysisTooltipPoint CreatePendingTooltipPoint(int moveNumber)
        => new()
        {
            Title = FormatMoveTitle(moveNumber),
            RawScoreText = "Pending",
            WinningChanceText = "Win chance pending",
            DisplayScoreText = "0.00"
        };

    private static AnalysisTooltipPoint CreateTooltipPoint(int moveNumber, Eval eval, double displayScore)
        => new()
        {
            Title = FormatMoveTitle(moveNumber),
            RawScoreText = AnalysisEvaluationMetrics.GetRawScoreText(eval.Score, eval.Mate),
            WinningChanceText = AnalysisEvaluationMetrics.GetWinningChance(eval.Score, eval.Mate)
                .ToString("0.0'%' white", CultureInfo.InvariantCulture),
            DisplayScoreText = displayScore.ToString("+0.00;-0.00;0.00", CultureInfo.InvariantCulture)
        };

    private static string FormatMoveTitle(int moveNumber)
        => moveNumber % 2 == 0
            ? $"{moveNumber / 2}... black"
            : $"{(moveNumber + 1) / 2}. white";

    private sealed record AnalysisEvaluationDataset : LineDataset
    {
        public IList<AnalysisTooltipPoint> TooltipPoints { get; set; } = [];
    }

    private sealed record AnalysisTooltipPoint
    {
        public string Title { get; init; } = string.Empty;
        public string RawScoreText { get; init; } = string.Empty;
        public string WinningChanceText { get; init; } = string.Empty;
        public string DisplayScoreText { get; init; } = string.Empty;
    }

    private static ChartJsConfig GetChartJsConfig()
    {
        return new()
        {
            Type = ChartType.line,
            Data = new ChartJsData
            {
                Labels = [],
                Datasets =
                [
                    new AnalysisEvaluationDataset
                    {
                        Id = EvaluationDatasetId,
                        Label = "Evaluation",
                        Data = [],
                        TooltipPoints = [],
                        BackgroundColor = "rgba(226, 232, 240, 0.2)",
                        BorderColor = "#9fd169",
                        Fill = new
                        {
                            target = "origin",
                            above = "rgba(159, 209, 105, 0.28)",
                            below = "rgba(218, 93, 75, 0.24)"
                        },
                        PointBackgroundColor = new IndexableOption<string>("#f4f7ef"),
                        PointBorderColor = new IndexableOption<string>("#1d211a"),
                        PointRadius = new IndexableOption<double>(2.5),
                        PointBorderWidth = new IndexableOption<double>(1.5),
                        PointHitRadius = new IndexableOption<double>(8),
                        SpanGaps = true,
                        Tension = 0.32
                    }
                ]
            },
            Options = new ChartJsOptions
            {
                Responsive = true,
                MaintainAspectRatio = false,
                OnClickEvent = true,
                Plugins = new Plugins
                {
                    Legend = new Legend
                    {
                        Position = "top"
                    },
                    Title = new Title
                    {
                        Display = false
                    },
                    Tooltip = new Tooltip
                    {
                        Enabled = true,
                        DisplayColors = false,
                        Callbacks = new TooltipCallbacks
                        {
                            Title = ChartJsFunction.FromName("analysisTooltipTitle"),
                            Label = ChartJsFunction.FromName("analysisTooltipLabel")
                        }
                    },
                    ArbitraryLines =
                    [
                        new ArbitraryLineConfig
                        {
                            ArbitraryLineColor = "#77a6d9",
                            XPosition = 0,
                            XWidth = 2,
                            Text = "Current"
                        }
                    ]
                },
                Scales = new ChartJsOptionsScales
                {
                    X = new LinearAxis
                    {
                        Display = true,
                        Title = new Title
                        {
                            Display = true,
                            Text = new IndexableOption<string>("Moves"),
                            Color = "#bcb4a8"
                        },
                        Ticks = new LinearAxisTick
                        {
                            Color = "#bcb4a8"
                        },
                        Grid = new ChartJsGrid
                        {
                            Color = "rgba(188, 180, 168, 0.18)"
                        }
                    },
                    Y = new LinearAxis
                    {
                        Display = true,
                        BeginAtZero = true,
                        Min = -AnalysisEvaluationMetrics.MateDisplayScore,
                        Max = AnalysisEvaluationMetrics.MateDisplayScore,
                        Title = new Title
                        {
                            Display = true,
                            Text = new IndexableOption<string>("Evaluation"),
                            Color = "#bcb4a8"
                        },
                        Ticks = new LinearAxisTick
                        {
                            Color = "#bcb4a8",
                            StepSize = 5
                        },
                        Grid = new ChartJsGrid
                        {
                            Color = "rgba(188, 180, 168, 0.18)"
                        }
                    }
                }
            }
        };
    }

    public void Dispose()
    {
        isAnalysing = false;
        cts.Cancel();
        cts.Dispose();
    }
}
