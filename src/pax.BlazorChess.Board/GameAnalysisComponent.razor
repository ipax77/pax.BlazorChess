@using pax.BlazorChartJs
@using System.Globalization
@using pax.BlazorChess.Board.Storage
@using pax.chess
@using pax.chess.Analyze
@using pax.chess.Extensions
@using pax.uciChessEngine
@using pax.uciChessEngine.EngineServices
@implements IDisposable

<div class="game-analysis">
    <div class="game-analysis-chart-shell @(isAnalysing ? "is-running" : "")">
        @if (AnalysisMode == GameAnalysisMode.EnabledEngines)
        {
            <div class="game-analysis-chart-toolbar">
                <label>
                    <span>View</span>
                    <select class="text-input"
                            value="@chartView"
                            disabled="@isAnalysing"
                            @onchange="ChartViewChanged">
                        <option value="@GameAnalysisChartView.Raw">Raw</option>
                        <option value="@GameAnalysisChartView.Adjusted">Adjusted</option>
                    </select>
                </label>
            </div>
        }

        <div class="game-analysis-chart">
            <ChartComponent ChartJsConfig="chartJsConfig" OnEventTriggered="ChartEventTriggerd" />
        </div>

        @if (isAnalysing)
        {
            <div class="game-analysis-overlay" aria-live="polite">
                <div class="game-analysis-spinner" aria-hidden="true"></div>
                <div>
                    <strong>Engine analysing</strong>
                    <span>@AnalysisProgressText</span>
                </div>
            </div>
        }
    </div>

    <aside class="game-analysis-summary" aria-label="Analysis summary">
        @if (AnalysisMode == GameAnalysisMode.EnabledEngines && engineResults.Count > 0)
        {
            <div class="engine-result-list" aria-label="Game analysis engines">
                @foreach (var result in engineResults)
                {
                    <div class="engine-result-row">
                        <span>@result.EngineName</span>
                        <small>@result.StatusText</small>
                    </div>
                }
            </div>
        }

        @if (MoveCount == 0)
        {
            <div class="analysis-empty">Load or play a game before running full-game analysis.</div>
        }
        else if (!HasEvaluations)
        {
            <div class="analysis-empty">Run analysis to classify moves and inspect the evaluation curve.</div>
        }
        else
        {
            <div class="summary-side">
                <span>White</span>
                @SummaryButton("Blunders", whiteSummary.BlunderMoves, "white", "blunder", "danger")
                @SummaryButton("Mistakes", whiteSummary.MistakeMoves, "white", "mistake", "warn")
                @SummaryButton("Inaccuracies", whiteSummary.InaccuracyMoves, "white", "inaccuracy", "info")
                @SummaryButton("Good", whiteSummary.ClubHouseMovesList, "white", "clubhouse", "ok")
                @SummaryButton("Best", whiteSummary.BestMovesList, "white", "best", "best")
            </div>
            <div class="summary-side">
                <span>Black</span>
                @SummaryButton("Blunders", blackSummary.BlunderMoves, "black", "blunder", "danger")
                @SummaryButton("Mistakes", blackSummary.MistakeMoves, "black", "mistake", "warn")
                @SummaryButton("Inaccuracies", blackSummary.InaccuracyMoves, "black", "inaccuracy", "info")
                @SummaryButton("Good", blackSummary.ClubHouseMovesList, "black", "clubhouse", "ok")
                @SummaryButton("Best", blackSummary.BestMovesList, "black", "best", "best")
            </div>
        }
    </aside>
</div>

@code {
    private const int ChartRefreshMs = 350;
    private const string EvaluationDatasetId = "game-analysis-evaluation";
    private const string CombinedDatasetId = "game-analysis-combined-average";
    private const int MaxParallelGameAnalysisEngines = 1;

    private static readonly string[] EnginePalette =
    [
        "#9fd169",
        "#8ed7ff",
        "#f2d16b",
        "#ff9f8f",
        "#c6a5ff",
        "#7ee0c3",
        "#f49bd4",
        "#b8d45f"
    ];

    [Parameter, EditorRequired]
    public required ChessGame ChessGame { get; set; }

    [Parameter]
    public AnalysisBoard? AnalysisBoard { get; set; }

    [Parameter]
    public EngineRunOptions? EngineRunOptions { get; set; }

    [Parameter]
    public IReadOnlyList<EngineRunOptions> EngineRunOptionsList { get; set; } = [];

    [Parameter]
    public GameAnalysisMode AnalysisMode { get; set; } = GameAnalysisMode.SelectedEngine;

    [Parameter]
    public int CurrentMoveNumber { get; set; }

    [Parameter]
    public EventCallback<int> OnMoveClicked { get; set; }

    [Parameter]
    public EventCallback OnAnnotationsChanged { get; set; }

    [Parameter]
    public int ThinkTimePerMoveMs { get; set; } = 1000;

    [Parameter]
    public int AnalysisThreads { get; set; }

    private readonly object evalLock = new();
    private CancellationTokenSource cts = new();
    private Eval?[] evals = [];
    private AnalysisMoveQuality?[] moveQualities = [];
    private List<string> chartLabels = [];
    private List<object> chartData = [];
    private List<AnalysisTooltipPoint> tooltipPoints = [];
    private readonly List<AnalysisEngineResult> engineResults = [];
    private AnalysisEngineResult? summaryResult;
    private double?[] combinedDisplayScores = [];
    private List<object> combinedChartData = [];
    private List<AnalysisTooltipPoint> combinedTooltipPoints = [];
    private AnalysisEvaluationDataset combinedDataset = null!;
    private readonly ArbitraryLineConfig currentLine = new()
    {
        ArbitraryLineColor = "#77a6d9",
        XPosition = 0,
        XWidth = 2,
        Text = "Current"
    };
    private AnalysisEvaluationDataset evaluationDataset = null!;
    private ChartJsConfig chartJsConfig = null!;
    private GameAnalysisMode configuredAnalysisMode = GameAnalysisMode.SelectedEngine;
    private GameAnalysisChartView chartView = GameAnalysisChartView.Raw;
    private bool chartReady;
    private bool isAnalysing;
    private bool chartDirty;
    private bool summaryDirty;
    private int analysedMoveCount;
    private int configuredMoveCount = -1;
    private int configuredCurrentMoveNumber = -1;
    private Guid configuredSelectedEngineId;

    private AnalysisSummary whiteSummary = new();
    private AnalysisSummary blackSummary = new();
    private string? lastCategoryClicked;
    private int lastCategoryIndex;

    private int MoveCount => ChessGame.Moves.Count;
    private int AnalysedMoveCount => analysedMoveCount;
    private bool HasEvaluations => evals.Any(static eval => eval is not null);
    public bool HasAnalysisResults => engineResults.Any(static result => result.AnalysedMoveCount > 0);
    public bool LastAnalysisCompletedNaturally { get; private set; }
    private string AnalysisProgressText
        => AnalysisMode == GameAnalysisMode.EnabledEngines && engineResults.Count > 1
            ? $"{engineResults.Sum(static r => r.AnalysedMoveCount)} / {Math.Max(1, engineResults.Count) * MoveCount} engine moves"
            : $"{AnalysedMoveCount} / {MoveCount} moves";

    protected override void OnInitialized()
    {
        chartJsConfig = GetChartJsConfig();
        ConfigureChartForCurrentGame();
    }

    protected override void OnParametersSet()
    {
        var selectedEngineId = EngineRunOptions?.Id ?? Guid.Empty;
        if (configuredMoveCount != MoveCount
            || configuredAnalysisMode != AnalysisMode
            || configuredSelectedEngineId != selectedEngineId)
        {
            ConfigureChartForCurrentGame();
        }
        else
        {
            UpdateCurrentLine(CurrentMoveNumber);
        }
    }

    public async Task Analyse()
    {
        if (isAnalysing || MoveCount == 0)
            return;

        var engines = SelectAnalysisEnginesForMode(AnalysisMode, EngineRunOptions, EngineRunOptionsList);
        if (engines.Count == 0)
            return;

        LastAnalysisCompletedNaturally = false;
        ResetAnalysisState(engines);
        isAnalysing = true;
        var completedNaturally = false;
        await InvokeAsync(StateHasChanged);

        _ = StartChartRefreshLoop();

        try
        {
            foreach (var batch in engineResults.Chunk(MaxParallelGameAnalysisEngines))
            {
                var tasks = batch
                    .Select(result => AnalyseEngineAsync(result, ReferenceEquals(result, summaryResult), cts.Token))
                    .ToArray();

                await Task.WhenAll(tasks);
                if (cts.IsCancellationRequested)
                    break;
            }

            completedNaturally = !cts.IsCancellationRequested;
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            isAnalysing = false;
            LastAnalysisCompletedNaturally = completedNaturally;
            RefreshChartData(forceSummary: true);

            if (completedNaturally && !cts.IsCancellationRequested && AddCategoryVariations())
                await OnAnnotationsChanged.InvokeAsync();

            await InvokeAsync(StateHasChanged);
        }
    }

    public void StopAnalysis()
    {
        if (!isAnalysing || cts.IsCancellationRequested)
            return;

        cts.Cancel();
    }

    public AnalysisMoveQuality? GetMoveQuality(int moveNumber)
    {
        lock (evalLock)
        {
            var index = moveNumber - 1;
            return index >= 0 && index < moveQualities.Length
                ? moveQualities[index]
                : null;
        }
    }

    public GameAnalysisRunSnapshot CreateAnalysisRunSnapshot()
    {
        lock (evalLock)
        {
            return new GameAnalysisRunSnapshot
            {
                AnalysisMode = AnalysisMode,
                MoveCount = MoveCount,
                MoveListFingerprint = GameAnalysisRunFingerprint.Create(ChessGame),
                ThinkTimePerMoveMs = ThinkTimePerMoveMs,
                AnalysisThreads = AnalysisThreads,
                Engines = engineResults
                    .Where(static result => result.AnalysedMoveCount > 0)
                    .Select(static result => new GameAnalysisEngineSnapshot
                    {
                        EngineId = result.EngineId,
                        EngineName = result.EngineName,
                        EngineType = result.EngineType,
                        BinaryPath = result.BinaryPath,
                        Evaluations = result.Evals
                            .Select(static (eval, index) => eval is null
                                ? null
                                : new GameAnalysisMoveEvaluationSnapshot
                                {
                                    MoveNumber = index + 1,
                                    Score = eval.Score,
                                    Mate = eval.Mate,
                                    Depth = eval.Depth,
                                    PvUciMoves = eval.PvInfo.Moves.ToList()
                                })
                            .Where(static eval => eval is not null)
                            .Select(static eval => eval!)
                            .ToList()
                    })
                    .ToList()
            };
        }
    }

    public bool LoadAnalysisRunSnapshot(GameAnalysisRunSnapshot snapshot)
    {
        ArgumentNullException.ThrowIfNull(snapshot);

        if (!GameAnalysisRunFingerprint.Matches(snapshot, ChessGame))
            return false;

        lock (evalLock)
        {
            engineResults.Clear();
            var fillRawDataset = snapshot.Engines.Count == 1;
            for (var i = 0; i < snapshot.Engines.Count; i++)
            {
                var result = new AnalysisEngineResult(snapshot.Engines[i], MoveCount, EnginePalette[i % EnginePalette.Length], fillRawDataset);
                foreach (var evaluation in snapshot.Engines[i].Evaluations)
                {
                    var index = evaluation.MoveNumber - 1;
                    if (index < 0 || index >= result.Evals.Length)
                        continue;

                    result.Evals[index] = new Eval
                    {
                        Score = evaluation.Score,
                        Mate = evaluation.Mate,
                        Depth = evaluation.Depth,
                        PvInfo = new pax.uciChessEngine.PvInfo
                        {
                            MultiPv = 1,
                            Depth = evaluation.Depth,
                            Score = evaluation.Score,
                            Mate = evaluation.Mate ?? 0,
                            Moves = evaluation.PvUciMoves.ToList()
                        }
                    };
                    result.AnalysedMoveCount++;
                }

                engineResults.Add(result);
            }

            summaryResult = FindSummaryResult() ?? engineResults.FirstOrDefault();
            evals = summaryResult?.Evals ?? new Eval?[MoveCount];
            analysedMoveCount = summaryResult?.AnalysedMoveCount ?? 0;
            EnsureMoveQualityStorage();
            ResetData(chartData, tooltipPoints);
            ResetData(combinedChartData, combinedTooltipPoints);
            Array.Clear(combinedDisplayScores);
            foreach (var result in engineResults)
            {
                ResetData(result.RawData, result.RawTooltipPoints);
                ResetData(result.AdjustedData, result.AdjustedTooltipPoints);
                Array.Clear(result.DisplayScores);
            }

            whiteSummary = new();
            blackSummary = new();
            CalculateSummary();
            lastCategoryClicked = null;
            lastCategoryIndex = 0;
            chartDirty = true;
            summaryDirty = false;
        }

        RefreshChartData(forceSummary: true);
        StateHasChanged();
        return true;
    }

    public static IReadOnlyList<EngineRunOptions> SelectAnalysisEnginesForMode(
        GameAnalysisMode mode,
        EngineRunOptions? selectedEngine,
        IReadOnlyList<EngineRunOptions> engines,
        Func<EngineRunOptions, bool>? isEnabledEngineAvailable = null)
    {
        if (mode == GameAnalysisMode.SelectedEngine)
            return selectedEngine is null ? [] : [selectedEngine];

        var predicate = isEnabledEngineAvailable ?? IsEnabledEngineAvailable;
        return engines.Where(predicate).ToList();
    }

    private async Task AnalyseEngineAsync(
        AnalysisEngineResult result,
        bool drivesSummary,
        CancellationToken token)
    {
        try
        {
            var engine = result.Engine
                ?? throw new InvalidOperationException("Restored analysis runs cannot be analysed without engine settings.");

            SetEngineStatus(result, "Starting");

            var provider = EngineService.GetEngineSessionProvider(engine);
            var requestedThreads = AnalysisThreads > 0
                ? AnalysisThreads
                : engine.Threads > 0
                    ? engine.Threads
                    : 8;
            var threads = Math.Clamp(requestedThreads, 1, Math.Max(1, Environment.ProcessorCount));
            await using var gameAnalysis = new GameAnalysis(provider, ChessGame, threads, Math.Max(100, ThinkTimePerMoveMs));

            SetEngineStatus(result, "Analysing");
            await foreach (var analysis in gameAnalysis.AnalyseGameStream(token))
            {
                if (analysis.Eval is null)
                    continue;

                var index = analysis.MoveNumber - 1;
                if (index < 0 || index >= result.Evals.Length)
                    continue;

                lock (evalLock)
                {
                    if (result.Evals[index] is null)
                        result.AnalysedMoveCount++;

                    result.Evals[index] = analysis.Eval;
                    if (drivesSummary)
                    {
                        evals = result.Evals;
                        analysedMoveCount = result.AnalysedMoveCount;
                        summaryDirty = true;
                    }

                    chartDirty = true;
                }
            }

            SetEngineStatus(result, token.IsCancellationRequested ? "Stopped" : "Ready");
        }
        catch (OperationCanceledException)
        {
            SetEngineStatus(result, "Stopped");
        }
        catch (Exception ex)
        {
            result.Error = ex.Message;
            SetEngineStatus(result, "Error");
        }
    }

    private void SetEngineStatus(AnalysisEngineResult result, string statusText)
    {
        lock (evalLock)
        {
            result.StatusText = statusText;
            chartDirty = true;
        }
    }

    private async Task StartChartRefreshLoop()
    {
        try
        {
            while (isAnalysing && !cts.IsCancellationRequested)
            {
                await Task.Delay(ChartRefreshMs, cts.Token);
                RefreshChartData(forceSummary: false);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void ConfigureChartForCurrentGame()
    {
        configuredMoveCount = MoveCount;
        configuredAnalysisMode = AnalysisMode;
        configuredSelectedEngineId = EngineRunOptions?.Id ?? Guid.Empty;
        engineResults.Clear();
        summaryResult = null;
        evals = new Eval?[MoveCount];
        moveQualities = new AnalysisMoveQuality?[MoveCount];
        analysedMoveCount = 0;
        whiteSummary = new();
        blackSummary = new();
        lastCategoryClicked = null;
        lastCategoryIndex = 0;
        chartDirty = false;
        summaryDirty = false;

        chartLabels = CreateChartLabels(MoveCount);
        chartData = CreatePendingChartData(MoveCount);
        tooltipPoints = CreatePendingTooltipPoints(MoveCount);
        combinedDisplayScores = new double?[MoveCount];
        combinedChartData = CreatePendingChartData(MoveCount);
        combinedTooltipPoints = CreatePendingTooltipPoints(MoveCount);
        evaluationDataset = CreateEvaluationDataset(EvaluationDatasetId, "Evaluation", chartData, tooltipPoints, "#9fd169", fillPrimary: true);
        combinedDataset = CreateEvaluationDataset(CombinedDatasetId, "Combined average", combinedChartData, combinedTooltipPoints, "#f2d16b", fillPrimary: false);
        configuredCurrentMoveNumber = UpdateCurrentLinePosition(CurrentMoveNumber);
        chartJsConfig.SetDatasetsSmooth([evaluationDataset], chartLabels);
    }

    private void ResetAnalysisState(IReadOnlyList<EngineRunOptions> engines)
    {
        if (cts.IsCancellationRequested)
        {
            cts.Dispose();
            cts = new CancellationTokenSource();
        }

        lock (evalLock)
        {
            engineResults.Clear();
            var fillRawDataset = engines.Count == 1;
            for (var i = 0; i < engines.Count; i++)
                engineResults.Add(new AnalysisEngineResult(engines[i], MoveCount, EnginePalette[i % EnginePalette.Length], fillRawDataset));

            summaryResult = FindSummaryResult() ?? engineResults.FirstOrDefault();
            evals = summaryResult?.Evals ?? new Eval?[MoveCount];
            EnsureMoveQualityStorage();
            Array.Clear(moveQualities);
            ResetChartData();
            analysedMoveCount = 0;
            whiteSummary = new();
            blackSummary = new();
            lastCategoryClicked = null;
            lastCategoryIndex = 0;
            chartDirty = true;
            summaryDirty = true;
        }
    }

    private AnalysisEngineResult? FindSummaryResult()
    {
        if (EngineRunOptions is null)
            return null;

        return engineResults.FirstOrDefault(r => r.EngineId == EngineRunOptions.Id);
    }

    private void RefreshChartData(bool forceSummary)
    {
        if (!chartReady)
        {
            if (forceSummary)
                RefreshSummaryData();

            return;
        }

        EnsureChartStorage();

        bool shouldUpdateChart;
        bool shouldUpdateSummary;

        lock (evalLock)
        {
            shouldUpdateChart = chartDirty;
            shouldUpdateSummary = forceSummary || summaryDirty;
            if (!shouldUpdateChart && !shouldUpdateSummary)
                return;

            if (shouldUpdateChart)
                RefreshChartDataFromEvaluations();

            if (shouldUpdateSummary)
                CalculateSummary();

            chartDirty = false;
            summaryDirty = false;
        }

        if (shouldUpdateChart)
            chartJsConfig.SetDatasetsSmooth(GetActiveDatasets(), chartLabels);
    }

    private void RefreshSummaryData()
    {
        lock (evalLock)
        {
            CalculateSummary();
            summaryDirty = false;
        }
    }

    private void UpdateCurrentLine(int moveNumber)
    {
        var currentMoveNumber = UpdateCurrentLinePosition(moveNumber);
        if (configuredCurrentMoveNumber == currentMoveNumber || !chartReady)
            return;

        configuredCurrentMoveNumber = currentMoveNumber;
        chartJsConfig.SetDatasetsSmooth(
            GetActiveDatasets(),
            chartLabels,
            updateOptions: true,
            updateAnimation: "none");
    }

    private int UpdateCurrentLinePosition(int moveNumber)
    {
        var currentMoveNumber = Math.Clamp(moveNumber, 0, MoveCount);
        currentLine.XPosition = currentMoveNumber;
        return currentMoveNumber;
    }

    private void ChartEventTriggerd(ChartJsEvent args)
    {
        if (args is ChartJsInitEvent)
        {
            chartReady = true;
            RefreshChartData(forceSummary: true);
        }
        else if (args is ChartJsLabelClickEvent clickEvent)
        {
            OnMoveClicked.InvokeAsync((int)clickEvent.DataX);
        }
    }

    private void ChartViewChanged(ChangeEventArgs args)
    {
        if (args.Value is string value
            && Enum.TryParse<GameAnalysisChartView>(value, out var view)
            && chartView != view)
        {
            chartView = view;
            lock (evalLock)
                chartDirty = true;

            RefreshChartData(forceSummary: false);
            StateHasChanged();
        }
    }

    private void RefreshChartDataFromEvaluations()
    {
        if (engineResults.Count == 0)
        {
            RefreshSingleEvaluationData(evals, chartData, tooltipPoints, "Evaluation");
            return;
        }

        foreach (var result in engineResults)
            RefreshEngineEvaluationData(result);

        RefreshAdjustedChartData();
    }

    private void RefreshEngineEvaluationData(AnalysisEngineResult result)
    {
        for (var i = 0; i < result.Evals.Length && i < result.RawData.Count; i++)
        {
            var eval = result.Evals[i];
            if (eval is null)
                continue;

            var displayScore = AnalysisEvaluationMetrics.GetDisplayScore(eval.Score, eval.Mate);
            result.DisplayScores[i] = displayScore;
            result.RawData[i] = displayScore;
            result.RawTooltipPoints[i] = CreateTooltipPoint(i + 1, eval, displayScore, result.EngineName);
        }
    }

    private void RefreshSingleEvaluationData(
        IReadOnlyList<Eval?> sourceEvals,
        List<object> data,
        List<AnalysisTooltipPoint> points,
        string engineName)
    {
        for (var i = 0; i < sourceEvals.Count && i < data.Count; i++)
        {
            var eval = sourceEvals[i];
            if (eval is null)
                continue;

            var displayScore = AnalysisEvaluationMetrics.GetDisplayScore(eval.Score, eval.Mate);
            data[i] = displayScore;
            points[i] = CreateTooltipPoint(i + 1, eval, displayScore, engineName);
        }
    }

    private void RefreshAdjustedChartData()
    {
        if (engineResults.Count == 0)
            return;

        for (var moveIndex = 0; moveIndex < combinedDisplayScores.Length && moveIndex < combinedChartData.Count; moveIndex++)
        {
            double sum = 0;
            var contributorCount = 0;
            foreach (var result in engineResults)
            {
                if (moveIndex >= result.DisplayScores.Length || result.DisplayScores[moveIndex] is not { } score)
                    continue;

                sum += score;
                contributorCount++;
            }

            if (contributorCount == 0)
            {
                combinedDisplayScores[moveIndex] = null;
                continue;
            }

            var average = sum / contributorCount;
            combinedDisplayScores[moveIndex] = average;
            combinedChartData[moveIndex] = average;
            combinedTooltipPoints[moveIndex] = CreateCombinedTooltipPoint(moveIndex + 1, average, contributorCount);
        }

        for (var engineIndex = 0; engineIndex < engineResults.Count; engineIndex++)
        {
            var result = engineResults[engineIndex];
            for (var moveIndex = 0; moveIndex < combinedDisplayScores.Length && moveIndex < result.AdjustedData.Count; moveIndex++)
            {
                if (moveIndex >= result.DisplayScores.Length
                    || result.DisplayScores[moveIndex] is not { } score
                    || combinedDisplayScores[moveIndex] is not { } average)
                {
                    continue;
                }

                var adjusted = score - average;
                result.AdjustedData[moveIndex] = adjusted;
                if (engineResults.Count > 1)
                {
                    result.RawTooltipPoints[moveIndex] = result.RawTooltipPoints[moveIndex] with
                    {
                        DifferenceText = FormatSigned(adjusted)
                    };
                }

                result.AdjustedTooltipPoints[moveIndex] = CreateAdjustedTooltipPoint(
                    moveIndex + 1,
                    result.Evals[moveIndex],
                    result.DisplayScores[moveIndex],
                    combinedDisplayScores[moveIndex],
                    adjusted,
                    result.EngineName);
            }
        }
    }

    private List<ChartJsDataset> GetActiveDatasets()
    {
        if (engineResults.Count == 0)
            return [evaluationDataset];

        if (chartView == GameAnalysisChartView.Adjusted && engineResults.Count > 1)
        {
            List<ChartJsDataset> adjusted = new(engineResults.Count + 1) { combinedDataset };
            foreach (var result in engineResults)
                adjusted.Add(result.AdjustedDataset);

            return adjusted;
        }

        List<ChartJsDataset> raw = new(engineResults.Count);
        foreach (var result in engineResults)
            raw.Add(result.RawDataset);

        return raw;
    }

    private void CalculateSummary()
    {
        var white = new AnalysisSummary();
        var black = new AnalysisSummary();
        double previousWinningChance = 50;
        EnsureMoveQualityStorage();
        Array.Clear(moveQualities);

        for (var i = 0; i < evals.Length; i++)
        {
            var eval = evals[i];
            if (eval is null)
                continue;

            var moveNumber = i + 1;
            var currentWinningChance = AnalysisEvaluationMetrics.GetWinningChance(eval.Score, eval.Mate);
            var quality = AnalysisEvaluationMetrics.ClassifyMoveQuality(
                moveNumber,
                previousWinningChance,
                currentWinningChance);
            moveQualities[i] = quality;

            if (moveNumber % 2 != 0)
            {
                UpdateSummary(white, quality, moveNumber);
            }
            else
            {
                UpdateSummary(black, quality, moveNumber);
            }

            previousWinningChance = currentWinningChance;
        }

        whiteSummary = white;
        blackSummary = black;
    }

    private bool AddCategoryVariations()
    {
        if (AnalysisBoard is null)
            return false;

        HashSet<int> criticalMoves = new(whiteSummary.BlunderMoves);
        criticalMoves.UnionWith(whiteSummary.MistakeMoves);
        criticalMoves.UnionWith(blackSummary.BlunderMoves);
        criticalMoves.UnionWith(blackSummary.MistakeMoves);

        var changed = false;
        foreach (var move in criticalMoves)
        {
            var eval = move > 0 && move <= evals.Length ? evals[move - 1] : null;
            if (eval is not null)
            {
                var label = GetCategoryLabel(move);
                changed |= AddVariationToAnalysisBoard(move, eval, label);
            }
        }

        return changed;
    }

    private string? GetCategoryLabel(int moveNumber)
    {
        if (whiteSummary.BlunderMoves.Contains(moveNumber)) return "White blunder";
        if (whiteSummary.MistakeMoves.Contains(moveNumber)) return "White mistake";
        if (blackSummary.BlunderMoves.Contains(moveNumber)) return "Black blunder";
        if (blackSummary.MistakeMoves.Contains(moveNumber)) return "Black mistake";
        return null;
    }

    private bool AddVariationToAnalysisBoard(int moveNumber, Eval eval, string? label)
    {
        if (AnalysisBoard is null || eval.PvInfo?.Moves is null || eval.PvInfo.Moves.Count == 0)
            return false;

        if (moveNumber >= MoveCount)
            return false;

        var node = GetMainLineNode(moveNumber);
        if (node is null)
            return false;

        if (PvStartsWithMainLine(node, eval.PvInfo.Moves[0]))
            return false;

        try
        {
            AnalysisBoard.AddVariation(node, eval.PvInfo);

            var firstMoveUci = eval.PvInfo.Moves.First();
            var firstNode = node.Children
                .FirstOrDefault(c => c.Move is not null && string.Equals(Uci.GetUci(c.Move), firstMoveUci, StringComparison.Ordinal));
            if (firstNode is not null)
            {
                firstNode.Note = label;
                firstNode.Evaluation = eval.Score;
                firstNode.Depth = eval.PvInfo.Depth;
            }

            return true;
        }
        catch
        {
            return false;
        }
    }

    private static bool PvStartsWithMainLine(MoveNode node, string firstMoveUci)
        => node.MainLine?.Move is not null
            && string.Equals(Uci.GetUci(node.MainLine.Move), firstMoveUci, StringComparison.Ordinal);

    private MoveNode? GetMainLineNode(int moveNumber)
    {
        if (AnalysisBoard is null || moveNumber <= 0)
            return null;

        var node = AnalysisBoard.Root.MainLine;
        var current = 1;
        while (node is not null && current < moveNumber)
        {
            node = node.MainLine;
            current++;
        }

        return node;
    }

    private void EnsureMoveQualityStorage()
    {
        if (moveQualities.Length != MoveCount)
            moveQualities = new AnalysisMoveQuality?[MoveCount];
    }

    private static void UpdateSummary(AnalysisSummary summary, AnalysisMoveQuality quality, int moveNumber)
    {
        switch (quality)
        {
            case AnalysisMoveQuality.Blunder:
                summary.BlunderMoves.Add(moveNumber);
                break;
            case AnalysisMoveQuality.Mistake:
                summary.MistakeMoves.Add(moveNumber);
                break;
            case AnalysisMoveQuality.Inaccuracy:
                summary.InaccuracyMoves.Add(moveNumber);
                break;
            case AnalysisMoveQuality.Good:
                summary.ClubHouseMovesList.Add(moveNumber);
                break;
            default:
                summary.BestMovesList.Add(moveNumber);
                break;
        }
    }

    private void JumpToCategoryMove(string player, string category)
    {
        var summary = player == "white" ? whiteSummary : blackSummary;
        var moves = category switch
        {
            "blunder" => summary.BlunderMoves,
            "mistake" => summary.MistakeMoves,
            "inaccuracy" => summary.InaccuracyMoves,
            "clubhouse" => summary.ClubHouseMovesList,
            "best" => summary.BestMovesList,
            _ => []
        };

        if (moves.Count == 0)
            return;

        var key = $"{player}_{category}";
        if (lastCategoryClicked == key)
            lastCategoryIndex = (lastCategoryIndex + 1) % moves.Count;
        else
        {
            lastCategoryClicked = key;
            lastCategoryIndex = 0;
        }

        OnMoveClicked.InvokeAsync(moves[lastCategoryIndex]);
    }

    private RenderFragment SummaryButton(
        string label,
        IReadOnlyCollection<int> moves,
        string player,
        string category,
        string tone)
        => @<button type="button"
                    class="summary-button @tone"
                    disabled="@(moves.Count == 0)"
                    title="@($"{label}: {moves.Count}")"
                    @onclick="() => JumpToCategoryMove(player, category)">
                <span>@label</span>
                <strong>@moves.Count</strong>
            </button>;

    private sealed class AnalysisSummary
    {
        public List<int> BlunderMoves { get; } = [];
        public List<int> MistakeMoves { get; } = [];
        public List<int> InaccuracyMoves { get; } = [];
        public List<int> ClubHouseMovesList { get; } = [];
        public List<int> BestMovesList { get; } = [];
    }

    private void EnsureChartStorage()
    {
        if (evaluationDataset is not null
            && chartData.Count == MoveCount
            && tooltipPoints.Count == MoveCount
            && chartLabels.Count == MoveCount)
        {
            return;
        }

        ConfigureChartForCurrentGame();
    }

    private void ResetChartData()
    {
        ResetData(chartData, tooltipPoints);
        ResetData(combinedChartData, combinedTooltipPoints);
        Array.Clear(combinedDisplayScores);
        foreach (var result in engineResults)
            result.Reset();
    }

    private static void ResetData(List<object> data, List<AnalysisTooltipPoint> points)
    {
        for (var i = 0; i < data.Count; i++)
        {
            data[i] = null!;
            points[i] = CreatePendingTooltipPoint(i + 1);
        }
    }

    private static List<string> CreateChartLabels(int moveCount)
    {
        List<string> labels = new(moveCount);
        for (var i = 0; i < moveCount; i++)
            labels.Add(i % 2 == 0 ? string.Empty : ((i + 1) / 2).ToString(CultureInfo.InvariantCulture));

        return labels;
    }

    private static List<object> CreatePendingChartData(int moveCount)
    {
        List<object> data = new(moveCount);
        for (var i = 0; i < moveCount; i++)
            data.Add(null!);

        return data;
    }

    private static List<AnalysisTooltipPoint> CreatePendingTooltipPoints(int moveCount)
    {
        List<AnalysisTooltipPoint> points = new(moveCount);
        for (var i = 0; i < moveCount; i++)
            points.Add(CreatePendingTooltipPoint(i + 1));

        return points;
    }

    private static AnalysisEvaluationDataset CreateEvaluationDataset(
        string datasetId,
        string label,
        List<object> data,
        List<AnalysisTooltipPoint> tooltipPoints,
        string color,
        bool fillPrimary,
        bool adjusted = false)
        => new()
        {
            Id = datasetId,
            Label = label,
            Data = data,
            TooltipPoints = tooltipPoints,
            BackgroundColor = new IndexableOption<string>(ToAlpha(color, fillPrimary ? 0.22 : 0.06)),
            BorderColor = new IndexableOption<string>(color),
            BorderDash = adjusted ? new IndexableOption<object>(new double[] { 6, 4 }) : null,
            BorderWidth = new IndexableOption<double>(fillPrimary ? 2.5 : 1.8),
            Fill = fillPrimary
                ? new
                {
                    target = "origin",
                    above = "rgba(159, 209, 105, 0.20)",
                    below = "rgba(218, 93, 75, 0.18)"
                }
                : false,
            PointBackgroundColor = new IndexableOption<string>("#f4f7ef"),
            PointBorderColor = new IndexableOption<string>("#1d211a"),
            PointRadius = new IndexableOption<double>(adjusted ? 1.6 : 2.5),
            PointBorderWidth = new IndexableOption<double>(1.2),
            PointHitRadius = new IndexableOption<double>(8),
            SpanGaps = true,
            Tension = new IndexableOption<double>(0.32)
        };

    private static string ToAlpha(string hexColor, double alpha)
    {
        if (hexColor.Length != 7 || hexColor[0] != '#')
            return hexColor;

        var red = Convert.ToInt32(hexColor[1..3], 16);
        var green = Convert.ToInt32(hexColor[3..5], 16);
        var blue = Convert.ToInt32(hexColor[5..7], 16);
        return string.Create(CultureInfo.InvariantCulture, $"rgba({red}, {green}, {blue}, {alpha:0.##})");
    }

    private static AnalysisTooltipPoint CreatePendingTooltipPoint(int moveNumber)
        => new()
        {
            Title = FormatMoveTitle(moveNumber),
            RawScoreText = "Pending",
            WinningChanceText = "Win chance pending",
            DisplayScoreText = "0.00"
        };

    private static AnalysisTooltipPoint CreateTooltipPoint(int moveNumber, Eval eval, double displayScore, string engineName)
        => new()
        {
            Title = $"{FormatMoveTitle(moveNumber)} / {engineName}",
            EngineName = engineName,
            RawScoreText = AnalysisEvaluationMetrics.GetRawScoreText(eval.Score, eval.Mate),
            WinningChanceText = AnalysisEvaluationMetrics.GetWinningChance(eval.Score, eval.Mate)
                .ToString("0.0'%' white", CultureInfo.InvariantCulture),
            DisplayScoreText = FormatSigned(displayScore)
        };

    private static AnalysisTooltipPoint CreateCombinedTooltipPoint(int moveNumber, double average, int contributorCount)
        => new()
        {
            Title = $"{FormatMoveTitle(moveNumber)} / combined",
            EngineName = "Combined average",
            RawScoreText = "Average",
            WinningChanceText = $"{contributorCount} engines",
            DisplayScoreText = FormatSigned(average)
        };

    private static AnalysisTooltipPoint CreateAdjustedTooltipPoint(
        int moveNumber,
        Eval? eval,
        double? displayScore,
        double? average,
        double adjusted,
        string engineName)
        => new()
        {
            Title = $"{FormatMoveTitle(moveNumber)} / {engineName}",
            EngineName = engineName,
            RawScoreText = eval is null ? "Pending" : AnalysisEvaluationMetrics.GetRawScoreText(eval.Score, eval.Mate),
            WinningChanceText = average is null
                ? "Average pending"
                : $"average {FormatSigned(average.Value)}",
            DisplayScoreText = FormatSigned(adjusted),
            DifferenceText = FormatSigned(adjusted)
        };

    private static string FormatSigned(double value)
        => value.ToString("+0.00;-0.00;0.00", CultureInfo.InvariantCulture);

    private static string FormatMoveTitle(int moveNumber)
        => moveNumber % 2 == 0
            ? $"{moveNumber / 2}... black"
            : $"{(moveNumber + 1) / 2}. white";

    private sealed record AnalysisEvaluationDataset : LineDataset
    {
        public IList<AnalysisTooltipPoint> TooltipPoints { get; set; } = [];
    }

    private sealed record AnalysisTooltipPoint
    {
        public string Title { get; init; } = string.Empty;
        public string EngineName { get; init; } = string.Empty;
        public string RawScoreText { get; init; } = string.Empty;
        public string WinningChanceText { get; init; } = string.Empty;
        public string DisplayScoreText { get; init; } = string.Empty;
        public string DifferenceText { get; init; } = string.Empty;
    }

    private sealed class AnalysisEngineResult
    {
        public AnalysisEngineResult(EngineRunOptions engine, int moveCount, string color, bool fillRawDataset)
            : this(
                engine,
                engine.Id,
                string.IsNullOrWhiteSpace(engine.Name) ? "Unnamed engine" : engine.Name!,
                string.IsNullOrWhiteSpace(engine.EngineType) ? EngineRunOptions.UciEngineType : engine.EngineType,
                engine.BinaryPath,
                moveCount,
                color,
                fillRawDataset)
        {
        }

        public AnalysisEngineResult(GameAnalysisEngineSnapshot engine, int moveCount, string color, bool fillRawDataset)
            : this(
                null,
                engine.EngineId,
                string.IsNullOrWhiteSpace(engine.EngineName) ? "Unnamed engine" : engine.EngineName,
                engine.EngineType,
                engine.BinaryPath,
                moveCount,
                color,
                fillRawDataset)
        {
        }

        private AnalysisEngineResult(
            EngineRunOptions? engine,
            Guid engineId,
            string engineName,
            string engineType,
            string binaryPath,
            int moveCount,
            string color,
            bool fillRawDataset)
        {
            Engine = engine;
            EngineId = engineId;
            EngineName = engineName;
            EngineType = engineType;
            BinaryPath = binaryPath;
            Evals = new Eval?[moveCount];
            DisplayScores = new double?[moveCount];
            RawData = CreatePendingChartData(moveCount);
            AdjustedData = CreatePendingChartData(moveCount);
            RawTooltipPoints = CreatePendingTooltipPoints(moveCount);
            AdjustedTooltipPoints = CreatePendingTooltipPoints(moveCount);
            RawDataset = CreateEvaluationDataset(
                $"game-analysis-{engineId:N}-raw",
                EngineName,
                RawData,
                RawTooltipPoints,
                color,
                fillPrimary: fillRawDataset);
            AdjustedDataset = CreateEvaluationDataset(
                $"game-analysis-{engineId:N}-adjusted",
                $"{EngineName} difference",
                AdjustedData,
                AdjustedTooltipPoints,
                color,
                fillPrimary: false,
                adjusted: true);
        }

        public EngineRunOptions? Engine { get; }
        public Guid EngineId { get; }
        public string EngineName { get; }
        public string EngineType { get; }
        public string BinaryPath { get; }
        public Eval?[] Evals { get; }
        public double?[] DisplayScores { get; }
        public List<object> RawData { get; }
        public List<object> AdjustedData { get; }
        public List<AnalysisTooltipPoint> RawTooltipPoints { get; }
        public List<AnalysisTooltipPoint> AdjustedTooltipPoints { get; }
        public AnalysisEvaluationDataset RawDataset { get; }
        public AnalysisEvaluationDataset AdjustedDataset { get; }
        public string StatusText { get; set; } = "Queued";
        public string Error { get; set; } = string.Empty;
        public int AnalysedMoveCount { get; set; }

        public void Reset()
        {
            Array.Clear(Evals);
            Array.Clear(DisplayScores);
            ResetData(RawData, RawTooltipPoints);
            ResetData(AdjustedData, AdjustedTooltipPoints);
            StatusText = "Queued";
            Error = string.Empty;
            AnalysedMoveCount = 0;
        }
    }

