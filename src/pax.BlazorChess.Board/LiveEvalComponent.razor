@using System.Globalization
@using System.Text
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@using pax.chess
@using pax.chess.Analyze
@using pax.chess.Extensions
@using pax.uciChessEngine
@using pax.uciChessEngine.EngineServices
@using pax.BlazorChess.Board.Modals
@inject ILogger<LiveEvalComponent> Logger
@inject IJSRuntime JS
@implements IAsyncDisposable

<div>
    <div class="d-flex align-items-center gap-2">
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault" @bind="IsActive" @bind:after="StartStop">
        </div>
        <select class="form-select" aria-label="Engines" @bind="currentId" @bind:after="SwitchEngine">
            @foreach (var options in EngineRunOptions)
            {
                <option value="@options.Id">@options.Name</option>
            }
        </select>
    </div>
    <div class="mt-2">
        @for (int index = 0; index < evals.Count; index++)
        {
            var eval = evals[index];
            <div class="live-eval-row live-eval-clickable"
                 title="Click for details"
                 @onclick="() => OpenEvalModal(index + 1, eval.Item1, eval.Item3, eval.Item1.PvInfo.Moves)">
                <span class="live-eval-rank">#@(index + 1)</span>
                <span class="live-eval-score">@GetEvalString(eval.Item1)</span>
                <span class="live-eval-depth">depth @eval.Item1.Depth</span>
                <div class="live-eval-moves">@GetMoves(eval.Item1.PvInfo.Moves, eval.Item2)</div>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary live-eval-copy"
                        title="Copy line"
                        aria-label="Copy line"
                        @onclick="() => CopyEvalLine(eval.Item1, eval.Item2, eval.Item3)"
                        @onclick:stopPropagation="true">
                    <span class="bi bi-clipboard" aria-hidden="true"></span>
                    <span class="visually-hidden">Copy</span>
                </button>
                <span class="live-eval-open bi bi-chevron-right" aria-hidden="true"></span>
            </div>
        }
    </div>
</div>

@if (showEvalModal && selectedEvalSnapshot is not null)
{
    <EvalModal EvalIndex="selectedEvalSnapshot.EvalIndex"
               EvalString="selectedEvalSnapshot.EvalString"
               Depth="selectedEvalSnapshot.Depth"
               StartingMoves="selectedEvalSnapshot.StartingMoves"
               PvMoves="selectedEvalSnapshot.PvMoves"
               OnClose="CloseEvalModal" />
}

<style>
    .live-eval-row {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        min-width: 0;
        flex-wrap: nowrap;
    }

    .live-eval-clickable {
        cursor: pointer;
    }

    .live-eval-clickable:hover {
        background-color: var(--bs-tertiary-bg, #f8f9fa);
        border-radius: 0.25rem;
    }

    .live-eval-clickable:focus-visible {
        outline: 2px solid var(--bs-primary, #0d6efd);
        outline-offset: 2px;
        border-radius: 0.25rem;
    }

    .live-eval-rank {
        color: var(--bs-secondary-color, #6c757d);
        text-align: right;
        width: 2.5rem;
        flex: 0 0 auto;
        font-variant-numeric: tabular-nums;
    }

    .live-eval-score {
        font-weight: 600;
        text-align: right;
        width: 4.5rem;
        flex: 0 0 auto;
        font-variant-numeric: tabular-nums;
    }

    .live-eval-depth {
        color: var(--bs-secondary-color, #6c757d);
        white-space: nowrap;
        flex: 0 0 auto;
    }

    .live-eval-moves {
        flex: 1 1 auto;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .live-eval-copy {
        flex: 0 0 auto;
        line-height: 1;
        padding: 0.2rem 0.35rem;
    }

    .live-eval-open {
        color: var(--bs-secondary-color, #6c757d);
        flex: 0 0 auto;
        font-size: 0.85rem;
    }

    @@media (max-width: 576px) {
        .live-eval-score {
            width: 3.5rem;
        }

        .live-eval-depth {
            font-size: 0.9rem;
        }
    }
</style>

@code {
    [Parameter, EditorRequired]
    public AnalysisBoard AnalysisBoard { get; set; }

    [Parameter, EditorRequired]
    public List<EngineRunOptions> EngineRunOptions { get; set; } = [];

    [Parameter]
    public bool IsActive { get; set; }

    [Parameter]
    public EventCallback<List<Move>> OnBestMovesReady { get; set; }

    Guid currentId;
    private EngineRunOptions? currentRunOptions;
    private IEngineSessionProvider? engineSessionProvider;

    private readonly List<(Eval, BoardPosition, List<string>)> evals = [];
    private Move? lastBestMove;
    private bool showEvalModal;
    private EvalSnapshot? selectedEvalSnapshot;

    private readonly CancellationTokenSource cts = new();
    private CancellationTokenSource? calcCts;
    private readonly SemaphoreSlim ss = new(1, 1);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        currentRunOptions = EngineRunOptions.FirstOrDefault();
        currentId = currentRunOptions?.Id ?? Guid.Empty;
    }

    public void RefreshEngineOptions()
    {
        if (EngineRunOptions.Count == 0)
        {
            currentRunOptions = null;
            currentId = Guid.Empty;
            return;
        }

        if (!EngineRunOptions.Any(o => o.Id == currentId))
        {
            currentRunOptions = EngineRunOptions.FirstOrDefault();
            currentId = currentRunOptions?.Id ?? Guid.Empty;

            if (IsActive && currentRunOptions is not null)
            {
                _ = Calculate();
            }
        }
    }

    public void Update()
    {
        if (IsActive)
            _ = Calculate();
    }

    private async Task Calculate()
    {
        if (!IsActive || currentRunOptions is null)
            return;

        lastBestMove = null;

        var old = Interlocked.Exchange(
            ref calcCts,
            CancellationTokenSource.CreateLinkedTokenSource(cts.Token));
        old?.Cancel();

        await ss.WaitAsync();
        var pos = AnalysisBoard.CurrentPosition.Clone();
        var moves = AnalysisBoard.GetCurrentEngineMoves();
        var startingMoves = moves.Split(" ", StringSplitOptions.RemoveEmptyEntries)
            .ToList();

        try
        {
            var token = calcCts!.Token;

            engineSessionProvider = EngineService
                .GetEngineSessionProvider(currentRunOptions);

            var lease = await engineSessionProvider.AcquireAsync(token);

            await lease.Session.UseAsync<Task>(async engine =>
            {


                await foreach (var evals in EngineService
                    .GetContinualEvaluation(moves, pos.SideToMove, engine, token))
                {
                    List<Move> bestMoves = [];
                    Move? bestMove = null;
                    foreach (var eval in evals)
                    {
                        var firstEngineMove = eval.PvInfo.Moves.FirstOrDefault();
                        if (firstEngineMove != null)
                        {
                            var bestMoveCandidate = Uci.CreateMove(firstEngineMove, pos);
                            if (bestMoveCandidate != null)
                            {
                                bestMoves.Add(bestMoveCandidate);
                                bestMove ??= bestMoveCandidate;
                            }
                        }
                    }
                    lastBestMove = bestMove;
                    UpdateEval(evals, pos, startingMoves);
                    await OnBestMovesReady.InvokeAsync(bestMoves);
                }

                return Task.CompletedTask;

            }, token);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            ss.Release();
            old?.Dispose();
        }
    }

    private void Stop()
    {
        calcCts?.Cancel();
    }

    private void UpdateEval(List<Eval> evals, BoardPosition pos, List<string> startingMoves)
    {
        this.evals.Clear();
        foreach (var eval in evals)
        {
            this.evals.Add((eval, pos, new List<string>(startingMoves)));
        }
        InvokeAsync(StateHasChanged);
    }


    private void StartStop()
    {
        if (IsActive)
        {
            _ = Calculate();
        }
        else
        {
            Stop();
        }
    }

    public bool IsRunning => IsActive;

    public void StartAnalysis()
    {
        if (IsActive)
            return;

        IsActive = true;
        StartStop();
    }

    public Move? GetBestMove() => lastBestMove;

    private async Task CopyEvalLine(Eval eval, BoardPosition pos, List<string> startingMoves)
    {
        var moves = GetMovesFromStart(startingMoves, eval.PvInfo.Moves);
        var line = $"{GetEvalString(eval)} depth {eval.Depth} {moves}";
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", line.Trim());
    }

    private string GetEvalPgn(IReadOnlyList<string> startingMoves, IReadOnlyList<string> pvMoves)
    {
        ChessGame game = new();
        var moves = startingMoves.Concat(pvMoves);
        foreach (var engineMove in moves)
        {
            var move = Uci.CreateMove(engineMove, game.CurrentPosition);
            if (move is null) continue;
            game.ApplyMove(move);
        }
        return PgnSerializer.Serialize(game);
    }

    private void SwitchEngine()
    {
        currentRunOptions = EngineRunOptions.FirstOrDefault(f => f.Id == currentId);
        if (IsActive)
            _ = Calculate();
    }

    private string GetEvalString(Eval eval)
    {
        if (eval.Mate != 0)
        {
            return $"M{eval.Mate}";
        }
        return (eval.Score / 100.0).ToString("N2", CultureInfo.InvariantCulture);
    }

    private string GetMoves(IReadOnlyList<string> engineMoves, BoardPosition pos)
    {
        StringBuilder sb = new();
        foreach (var engineMove in engineMoves)
        {
            try
            {
                var move = Uci.CreateMove(engineMove, pos);
                ArgumentNullException.ThrowIfNull(move);
                var san = PgnSerializer.ToSan(move, pos);
                sb.Append(san + " ");
                pos = pos.MakeMove(move);
            }
            catch (Exception ex)
            {
                Logger.LogError("invalid move {move}", engineMove, ex);
            }
        }
        if (sb.Length > 0)
            sb.Length--;
        return sb.ToString();
    }

    private string GetMovesFromStart(IReadOnlyList<string> startingMoves, IReadOnlyList<string> pvMoves)
    {
        StringBuilder sb = new();
        ChessGame game = new();

        var moves = startingMoves.Concat(pvMoves);
        foreach (var engineMove in moves)
        {
            try
            {
                var move = Uci.CreateMove(engineMove, game.CurrentPosition);
                ArgumentNullException.ThrowIfNull(move);
                var san = PgnSerializer.ToSan(move, game.CurrentPosition);
                sb.Append(san + " ");
                game.ApplyMove(move);
            }
            catch (Exception ex)
            {
                Logger.LogError("invalid move {move}", engineMove, ex);
            }
        }

        if (sb.Length > 0)
            sb.Length--;

        return sb.ToString();
    }

    private void OpenEvalModal(int evalIndex, Eval eval, List<string> startingMoves, IReadOnlyList<string> pvMoves)
    {
        selectedEvalSnapshot = new EvalSnapshot
        {
            EvalIndex = evalIndex,
            EvalString = GetEvalString(eval),
            Depth = eval.Depth,
            StartingMoves = new List<string>(startingMoves),
            PvMoves = pvMoves.ToList()
        };
        showEvalModal = true;
    }

    private void CloseEvalModal()
    {
        showEvalModal = false;
        selectedEvalSnapshot = null;
    }

    private sealed class EvalSnapshot
    {
        public int EvalIndex { get; init; }
        public string EvalString { get; init; } = string.Empty;
        public int Depth { get; init; }
        public List<string> StartingMoves { get; init; } = [];
        public List<string> PvMoves { get; init; } = [];
    }

    public async ValueTask DisposeAsync()
    {
        cts.Cancel();
        cts.Dispose();
        ss.Dispose();
    }
}
