@using System.Text
@using pax.chess
@using pax.chess.Analyze
@using pax.chess.Extensions
@using pax.uciChessEngine
@using Microsoft.JSInterop

@if (isVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">Evaluation #@EvalIndex</h5>
                        <div class="text-secondary small">@EvalString · depth @Depth</div>
                    </div>
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary me-2"
                            title="Copy line"
                            aria-label="Copy line"
                            @onclick="CopyEvalLine">
                        <span class="bi bi-clipboard" aria-hidden="true"></span>
                    </button>
                    <button type="button" class="btn-close" @onclick="Hide" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (evalBoard is not null)
                    {
                        <div class="row eval-modal-focus" tabindex="0" @onkeydown="KeyDown" @onkeydown:stopPropagation="true" @onkeydown:preventDefault="true">
                            <div class="col-6">
                                <BoardComponent @ref="boardComponent" Position="evalBoard.CurrentPosition" />
                            </div>
                            <div class="col-6">
                                <div style="max-height: 70vh;">
                                    <AnalysisAnnotationComponent AnalysisBoard="evalBoard" OnNodeClicked="NodeClicked" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="Hide">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isVisible;

    [Parameter, EditorRequired]
    public int EvalIndex { get; set; }

    [Parameter, EditorRequired]
    public string EvalString { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public int Depth { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<string> StartingMoves { get; set; } = Array.Empty<string>();

    [Parameter, EditorRequired]
    public IReadOnlyList<string> PvMoves { get; set; } = Array.Empty<string>();

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Inject]
    public IJSRuntime JS { get; set; } = default!;

    private AnalysisBoard? evalBoard;
    private BoardComponent? boardComponent;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        evalBoard = BuildEvalBoard(StartingMoves, PvMoves);
    }

    private AnalysisBoard BuildEvalBoard(IReadOnlyList<string> startingMoves, IReadOnlyList<string> pvMoves)
    {
        ChessGame game = new();
        foreach (var engineMove in startingMoves.Concat(pvMoves))
        {
            var move = Uci.CreateMove(engineMove, game.CurrentPosition);
            if (move is null) continue;
            var san = PgnSerializer.ToSan(move, game.CurrentPosition);
            game.ApplyMove(move, san);
        }
        var board = new AnalysisBoard(game);
        while (board.CurrentNode.MainLine != null)
        {
            board.MoveForward();
        }
        return board;
    }

    private async Task CopyEvalLine()
    {
        var moves = GetMovesFromStart(StartingMoves, PvMoves);
        var line = $"{EvalString} depth {Depth} {moves}";
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", line.Trim());
    }

    private void NodeClicked(MoveNode node)
    {
        if (evalBoard is null)
            return;

        evalBoard.MoveToNode(node);
        boardComponent?.Update(evalBoard.CurrentPosition, node.Move);
    }

    private void KeyDown(KeyboardEventArgs args)
    {
        if (evalBoard is null)
            return;

        if (args.Key == "ArrowLeft")
        {
            evalBoard.MoveBackward();
            boardComponent?.Update(evalBoard.CurrentPosition, evalBoard.CurrentNode.Move);
        }
        else if (args.Key == "ArrowRight")
        {
            evalBoard.MoveForward();
            boardComponent?.Update(evalBoard.CurrentPosition, evalBoard.CurrentNode.Move);
        }
    }

    private string GetMovesFromStart(IReadOnlyList<string> startingMoves, IReadOnlyList<string> pvMoves)
    {
        StringBuilder sb = new();
        ChessGame game = new();

        foreach (var engineMove in startingMoves.Concat(pvMoves))
        {
            try
            {
                var move = Uci.CreateMove(engineMove, game.CurrentPosition);
                ArgumentNullException.ThrowIfNull(move);
                var san = PgnSerializer.ToSan(move, game.CurrentPosition);
                sb.Append(san + " ");
                game.ApplyMove(move, san);
            }
            catch (Exception)
            {
                // Ignore invalid moves in this context.
            }
        }

        if (sb.Length > 0)
            sb.Length--;

        return sb.ToString();
    }

    public void Show()
    {
        isVisible = true;
        StateHasChanged();
    }

    public void Hide()
    {
        isVisible = false;
        OnClose.InvokeAsync();
        StateHasChanged();
    }
}
