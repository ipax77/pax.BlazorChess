@page "/position-lab"
@using pax.BlazorChess.Board.Storage
@using pax.BlazorChess.Web.Components.ChessBoard
@using pax.BlazorChess.Web.Components.PositionImport
@using pax.BlazorChess.Web.Components.Results
@using pax.BlazorChess.Web.Models
@using pax.BlazorChess.Web.Components.Engine
@using pax.BlazorChess.Board
@using pax.chess
@using pax.uciChessEngine.EngineServices
@inject IChessBoardRepository Repository
@inject NavigationManager Navigation
@inject Services.PositionWorkspaceState Workspace
@rendermode InteractiveServer

<PageTitle>Position Lab</PageTitle>

<section class="workspace-page keyboard-workspace"
         tabindex="0"
         @onkeydown="KeyDown">
    <header class="page-header">
        <div>
            <p class="eyebrow">Get or inspect a position</p>
            <h1>Position Lab</h1>
        </div>
        <div class="header-actions">
            <button type="button" class="btn btn-primary" disabled="@(engineRunOptions.Count == 0)" @onclick="AnalyzeCurrentPosition">Analyze position</button>
            <button type="button" class="btn btn-outline-light" disabled="@(!HasMoveHistory || SelectedEngine is null)" @onclick="AnalyzeImportedGame">Analyze game</button>
            <button type="button" class="btn btn-primary" @onclick="EngineVsEngine">Engine vs engine</button>
        </div>
    </header>

    <div class="content-grid png-workflow-grid">
        <ImageUploader OnImageLoaded="ImageLoaded" />

        <div class="tool-panel import-panel">
            <div class="tool-panel-header">
                <h2>Confirm Position</h2>
                <span class="subtle">FEN / PGN fallback</span>
            </div>

            <label class="form-label" for="fenInput">FEN</label>
            <textarea id="fenInput" class="form-control font-monospace import-text" @bind="fenInput"></textarea>
            <div class="d-flex gap-2 mt-2">
                <button type="button" class="btn btn-primary" @onclick="ImportFen">Load FEN</button>
                <button type="button" class="btn btn-outline-light" @onclick="LoadStart">Start</button>
            </div>

            <label class="form-label mt-4" for="pgnInput">PGN</label>
            <textarea id="pgnInput" class="form-control font-monospace import-text large" @bind="pgnInput"></textarea>
            <div class="d-flex gap-2 mt-2">
                <button type="button" class="btn btn-primary" @onclick="ImportPgn">Load PGN</button>
                <button type="button" class="btn btn-outline-light" @onclick="ClearPgn">Clear</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(importError))
            {
                <div class="alert alert-warning mt-3 mb-0">@importError</div>
            }
        </div>

        <div>
            <ChessBoard @ref="boardView" Position="Workspace.AnalysisBoard.CurrentPosition" />
            <div class="mt-3">
                <FenViewer Position="Workspace.AnalysisBoard.CurrentPosition" />
            </div>
        </div>
    </div>

    <div class="content-grid lab-analysis-grid">
        <div class="side-stack">
            <DetectionResultPanel Snapshot="Snapshot" />
            <PositionCorrectionPanel Position="Workspace.AnalysisBoard.CurrentPosition" OnPositionChanged="CorrectPosition" />
            <MoveList AnalysisBoard="Workspace.AnalysisBoard" OnMoveClicked="MoveToNode" />
        </div>

        <div class="side-stack">
            <div class="tool-panel">
                <div class="tool-panel-header">
                    <h2>Position Analysis</h2>
                    <button type="button" class="btn btn-sm btn-primary" disabled="@(engineRunOptions.Count == 0)" @onclick="AnalyzeCurrentPosition">Analyze</button>
                </div>
                @if (engineRunOptions.Count == 0)
                {
                    <div class="empty-state">Configure an engine before analysis.</div>
                }
                else
                {
                    <EngineSelector Title="Engine" EngineRunOptions="engineRunOptions" @bind-SelectedEngineId="selectedEngineId" />
                    <div class="mt-3">
                        <LiveEvalComponent @ref="liveEval"
                                           AnalysisBoard="Workspace.AnalysisBoard"
                                           EngineRunOptions="engineRunOptions"
                                           OnBestMovesReady="BestMovesReady" />
                    </div>
                }
            </div>

            <EvaluationChart @ref="evaluationChart"
                             ChessGame="Workspace.AnalysisBoard.ChessGame"
                             AnalysisBoard="Workspace.AnalysisBoard"
                             EngineRunOptions="SelectedEngine"
                             ThinkTimePerMoveMs="thinkTimePerMoveMs" />
        </div>

        <div class="tool-panel">
            <div class="tool-panel-header">
                <h2>Actions</h2>
                <span class="subtle">Current position</span>
            </div>
            <div class="action-grid">
                <button type="button" class="btn btn-outline-light" disabled="@(engineRunOptions.Count == 0)" @onclick="AnalyzeCurrentPosition">Analyze position</button>
                <button type="button" class="btn btn-outline-light" disabled="@(!HasMoveHistory || SelectedEngine is null)" @onclick="AnalyzeImportedGame">Analyze imported game</button>
                <button type="button" class="btn btn-outline-light" @onclick="EngineVsEngine">Engine vs Engine from here</button>
                <button type="button" class="btn btn-outline-light" @onclick="SavePosition">Save position</button>
            </div>
            <label class="form-label mt-3" for="saveName">Save name</label>
            <input id="saveName" class="form-control" @bind="saveName" />
            @if (!string.IsNullOrWhiteSpace(saveMessage))
            {
                <div class="alert alert-info mt-3 mb-0">@saveMessage</div>
            }
        </div>
        <PgnViewer ChessGame="Workspace.AnalysisBoard.ChessGame" />
    </div>
</section>

@code {
    private string fenInput = string.Empty;
    private string pgnInput = string.Empty;
    private string saveName = "Position";
    private string? importError;
    private string? saveMessage;
    private string? imageStatus;
    private int thinkTimePerMoveMs = 1000;
    private List<EngineRunOptions> engineRunOptions = [];
    private Guid selectedEngineId;
    private ChessBoard? boardView;
    private LiveEvalComponent? liveEval;
    private EvaluationChart? evaluationChart;

    private PositionSnapshot Snapshot => PositionSnapshot.FromPosition(Workspace.AnalysisBoard.CurrentPosition);
    private bool HasMoveHistory => Workspace.AnalysisBoard.ChessGame.Moves.Count > 0;
    private EngineRunOptions? SelectedEngine => engineRunOptions.FirstOrDefault(e => e.Id == selectedEngineId)
        ?? engineRunOptions.FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        fenInput = Workspace.Fen;
        engineRunOptions = await Repository.GetEngineRunOptions();
        selectedEngineId = engineRunOptions.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private void ImportFen()
    {
        try
        {
            Workspace.SetFen(fenInput);
            importError = null;
            saveMessage = null;
            imageStatus = null;
            fenInput = Workspace.Fen;
        }
        catch (Exception ex)
        {
            importError = $"Could not load FEN: {ex.Message}";
        }
    }

    private void ImportPgn()
    {
        try
        {
            Workspace.SetPgn(pgnInput);
            importError = null;
            saveMessage = null;
            imageStatus = null;
            fenInput = Workspace.Fen;
        }
        catch (Exception ex)
        {
            importError = $"Could not load PGN: {ex.Message}";
        }
    }

    private void LoadStart()
    {
        Workspace.SetPosition(BoardPosition.CreateInitial(), "Start");
        fenInput = Workspace.Fen;
        importError = null;
    }

    private void ClearPgn() => pgnInput = string.Empty;

    private void CorrectPosition(BoardPosition position)
    {
        Workspace.SetPosition(position, "Manual correction");
        fenInput = Workspace.Fen;
    }

    private void MoveToNode(pax.chess.Analyze.MoveNode node)
    {
        Workspace.AnalysisBoard.MoveToNode(node);
        boardView?.Update(Workspace.AnalysisBoard.CurrentPosition, node.Move);
    }

    private void KeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "ArrowLeft")
        {
            Workspace.AnalysisBoard.MoveBackward();
            fenInput = Workspace.Fen;
            boardView?.Update(Workspace.AnalysisBoard.CurrentPosition, Workspace.AnalysisBoard.CurrentNode.Move);
        }
        else if (args.Key == "ArrowRight")
        {
            Workspace.AnalysisBoard.MoveForward();
            fenInput = Workspace.Fen;
            boardView?.Update(Workspace.AnalysisBoard.CurrentPosition, Workspace.AnalysisBoard.CurrentNode.Move);
        }
    }

    private void BestMovesReady(List<Move> moves)
    {
        boardView?.AddBestMoveAnnotations(moves);
    }

    private void AnalyzeCurrentPosition()
    {
        if (liveEval is not null)
            liveEval.StartAnalysis();
    }

    private async Task AnalyzeImportedGame()
    {
        if (evaluationChart is not null)
            await evaluationChart.Analyze();
    }

    private void EngineVsEngine() => Navigation.NavigateTo("engine-arena");

    private void ImageLoaded(string imageDataUrl)
    {
        imageStatus = "PNG loaded. Detector is not configured yet; confirm the FEN manually and analyze here.";
        saveMessage = imageStatus;
    }

    private async Task SavePosition()
    {
        var id = await Repository.SaveAnalyzedGame(saveName, Workspace.AnalysisBoard);
        saveMessage = $"Saved {saveName} ({id}).";
    }
}
