@using pax.chess

<div class="w-100">
    <div id="@BoardGuid" 
         class="chess-board shadow-sm"
         @onpointermove="HandlePointerMove"
         @onpointerup="(e) => HandlePointerUp(e, default)"
         @ondragover:preventDefault
         @oncontextmenu:preventDefault
         style="touch-action: none;">
        @for (int viewRank = 0; viewRank < 8; viewRank++)
        {
            var rank = WhiteAtBottom ? 7 - viewRank : viewRank;

            @for (int viewFile = 0; viewFile < 8; viewFile++)
            {
                var file = WhiteAtBottom ? viewFile : 7 - viewFile;
                var square = new Square(file, rank);
                var piece = CurrentGame.CurrentPosition.Board[square.Index];
                var isLightSquare = IsLightSquare(file, rank);
                var isSelected = SelectedSquare != null && SelectedSquare.Value.Index == square.Index;
                var isLastMoveFrom = LastMoveFrom != null && LastMoveFrom.Value.Index == square.Index;
                var isLastMoveTo = LastMoveTo != null && LastMoveTo.Value.Index == square.Index;
                var isDragging = _draggingSquare?.Index == square.Index;
                var squareId = $"{BoardGuid}_{square.Index}";

                <button type="button"
                        id="@squareId"
                        class="square @(isLightSquare ? "light" : "dark") @(isSelected ? "selected" : "") @(isLastMoveFrom || isLastMoveTo ? "last-move" : "") @(isDragging ? "dragging-parent" : "") btn p-0 border-0"
                        title="@square"
                        aria-label="@GetSquareLabel(square, piece)"
                        @onclick="() => HandleSquareClick(square)"
                        @onpointerdown="(e) => HandlePointerDown(e, square)"
                        @onpointerup:stopPropagation
                        @onpointerup="(e) => HandlePointerUp(e, square)">
                    @if (piece.HasValue)
                    {
                        <img src="@GetPieceSvg(piece.Value)"
                             class="piece @(isDragging ? "dragging" : "")"
                             style="@(isDragging ? $"transform: translate({_dragX}px, {_dragY}px); z-index: 100;" : "")"
                             alt="@GetPieceAlt(piece.Value)"
                             draggable="false" />
                    }
                    
                    @if (viewFile == 0)
                    {
                        <span class="coordinate rank-label @(isLightSquare ? "dark-text" : "light-text")">
                            @GetRankLabel(rank)
                        </span>
                    }
                    
                    @if (viewRank == 7)
                    {
                        <span class="coordinate file-label @(isLightSquare ? "dark-text" : "light-text")">
                            @GetFileLabel(file)
                        </span>
                    }
                </button>
            }
        }
    </div>
</div>
