@inject IJSRuntime JS
<div class="chess-annotation">
    <div class="moves-grid" @ref="movesGrid">
        @for (int i = 0; i < moves.Count; i += 2)
        {
            var moveNumber = (i / 2) + 1;
            var whiteMove = moves[i];
            var blackMove = (i + 1 < moves.Count) ? moves[i + 1] : null;

            <div class="move-row @(moveNumber % 2 == 0 ? "even" : "")">
                <span class="move-number">@moveNumber</span>
                <span class="move-cell white-move @(IsLastMove(i) ? "last-move" : "")">@whiteMove</span>
                <span class="move-cell black-move @(blackMove != null && IsLastMove(i + 1) ? "last-move" : "")">
                    @(blackMove ?? "")
                </span>
            </div>
        }
    </div>
</div>

@code {
    List<string> moves = [];
    ElementReference movesGrid;

    public void Update(string move)
    {
        moves.Add(move);
        InvokeAsync(StateHasChanged);
        JS.InvokeVoidAsync("scrollToBottom", movesGrid);
    }

    private bool IsLastMove(int index) => index == moves.Count - 1;
}
