@using pax.BlazorChess.Shared.Common
@using pax.chess
@using pax.chess.Validation
@using Microsoft.AspNetCore.Components.Web
@implements IAsyncDisposable

<div class="w-100">
    <div class="board-surface" @oncontextmenu:preventDefault>
        <div id="@BoardGuid"
             class="chess-board"
             @ondragover:preventDefault="true"
             @onpointermove="OnPointerMove"
             @onpointerup="OnPointerUp"
             @onpointercancel="OnPointerCancel">

            @for (int viewRank = 0; viewRank < 8; viewRank++)
            {
                var rank = BlackAtBottom ? viewRank : 7 - viewRank;

                @for (int viewFile = 0; viewFile < 8; viewFile++)
                {
                    var file = BlackAtBottom ? 7 - viewFile : viewFile;
                    var square = new Square(file, rank);
                    var piece = Game.CurrentPosition.Board[square.Index];
                    var isLightSquare = IsLightSquare(file, rank);
                    var squareId = $"{BoardGuid}_{square.Index}";

                    <div id="@squareId"
                         class="@GetSquareCssClass(square)"
                         title="@square"
                         aria-label="@GetSquareLabel(square, piece)"
                         @onpointerdown="(e) => OnPointerDown(square, e)">

                        @if (piece.HasValue && !(dragging && pointerDownSquare == square))
                        {
                            <img src="@GetPieceSvg(piece.Value)"
                                 class="piece"
                                 alt="@GetPieceAlt(piece.Value)"
                                 draggable="false" />
                        }

                        @if (viewFile == 0)
                        {
                            <span class="coordinate rank-label @(isLightSquare ? "dark-text" : "light-text")">
                                @GetRankLabel(rank)
                            </span>
                        }

                        @if (viewRank == 7)
                        {
                            <span class="coordinate file-label @(isLightSquare ? "dark-text" : "light-text")">
                                @GetFileLabel(file)
                            </span>
                        }
                    </div>
                }
            }
        </div>

        <svg class="board-overlay" viewBox="0 0 100 100" preserveAspectRatio="none">
            <defs>
                @foreach (var markerColor in MarkerColors)
                {
                    <marker id="@GetMarkerId(markerColor)"
                            markerWidth="6"
                            markerHeight="6"
                            refX="5.2"
                            refY="3"
                            orient="auto"
                            markerUnits="strokeWidth">
                        <path d="M0,0 L0,6 L6,3 z" fill="@markerColor"></path>
                    </marker>
                }
            </defs>

            @foreach (var annotation in _annotations)
            {
                @if (annotation.IsArrow)
                {
                    var (startX, startY) = GetSquareCenter(annotation.FromSquareIndex);
                    var (endX, endY) = GetSquareCenter(annotation.ToSquareIndex);

                    <line x1="@startX.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                          y1="@startY.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                          x2="@endX.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                          y2="@endY.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                          class="board-arrow"
                          stroke="@annotation.Color"
                          marker-end="url(#@GetMarkerId(annotation.Color))" />
                }
                else
                {
                    var (centerX, centerY) = GetSquareCenter(annotation.FromSquareIndex);

                    <circle cx="@centerX.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                            cy="@centerY.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                            class="board-circle"
                            stroke="@annotation.Color" />
                }
            }

            @if (_activeDrawing.HasValue && _activeHoverSquareIndex.HasValue && _activeHoverSquareIndex.Value != _activeDrawing.Value.StartSquareIndex)
            {
                var (startX, startY) = GetSquareCenter(_activeDrawing.Value.StartSquareIndex);
                var (endX, endY) = GetSquareCenter(_activeHoverSquareIndex.Value);

                <line x1="@startX.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                      y1="@startY.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                      x2="@endX.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                      y2="@endY.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"
                      class="board-arrow board-arrow-preview"
                      stroke="@_activeDrawing.Value.Color"
                      marker-end="url(#@GetMarkerId(_activeDrawing.Value.Color))" />
            }
        </svg>
    </div>

    @if (dragging && dragPieceSvg is not null)
    {
        <img src="@dragPieceSvg"
             class="piece piece-drag-preview"
             style="@GetDragPreviewStyle()"
             alt=""
             aria-hidden="true"
             draggable="false" />
    }
</div>

@code {

    public string BoardGuid { get; } = $"playboard_{Guid.NewGuid():N}";
    private static readonly string[] MarkerColors = ["#8bc34a", "#f44336", "#03a9f4", "#ff9800"];
    private readonly List<BoardAnnotation> _annotations = [];
    private ActiveDrawing? _activeDrawing;
    private int? _activeHoverSquareIndex;
    private int? drawingPointerId;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    [Parameter] public ChessGame Game { get; set; } = new();

    [Parameter] public PieceColor PlayColor { get; set; } = PieceColor.White;

    [Parameter] public EventCallback<Move> OnMovePlayed { get; set; }

    bool BlackAtBottom => PlayColor == PieceColor.Black;

    private IJSObjectReference? module;

    private Square? selectedSquare;
    private List<Square> validDestinations = [];

    private Square? pointerDownSquare;

    private bool pointerDown;
    private bool dragging;

    private int? activePointerId;

    private double startX;
    private double startY;

    private double dragX;
    private double dragY;

    private string? dragPieceSvg;

    private const double DragThreshold = 6;

    private Move? lastMove => Game.Moves.LastOrDefault()?.Move;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/pax.BlazorChess.Shared/Components/BoardPlayComponent.razor.js");
            await module.InvokeVoidAsync("updateBoardSize", BoardGuid);
        }
    }

    public void Update()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task OnPointerDown(Square square, PointerEventArgs e)
    {
        if (e.Button == 2)
        {
            _activeDrawing = new ActiveDrawing(square.Index, SelectDrawColor(e));
            _activeHoverSquareIndex = square.Index;
            drawingPointerId = (int)e.PointerId;

            if (module is not null)
                await module.InvokeVoidAsync("setPointerCapture", BoardGuid, drawingPointerId.Value);

            StateHasChanged();
            return;
        }

        if (e.Button != 0)
            return;

        _annotations.Clear();
        pointerDown = true;
        activePointerId = (int)e.PointerId;
        pointerDownSquare = square;

        startX = e.ClientX;
        startY = e.ClientY;

        dragX = startX;
        dragY = startY;

        var piece = Game.CurrentPosition.Board[square.Index];

        if (piece.HasValue)
            dragPieceSvg = GetPieceSvg(piece.Value);

        if (module is not null)
            await module.InvokeVoidAsync("setPointerCapture", BoardGuid, activePointerId.Value);
    }

    private async Task OnPointerMove(PointerEventArgs e)
    {
        if (_activeDrawing.HasValue && drawingPointerId == (int)e.PointerId)
        {
            if (module is not null)
            {
                var squareIndex = await module.InvokeAsync<int?>(
                    "getSquareIndexFromPoint",
                    e.ClientX,
                    e.ClientY,
                    BoardGuid);

                if (_activeHoverSquareIndex != squareIndex)
                {
                    _activeHoverSquareIndex = squareIndex;
                    StateHasChanged();
                }
            }

            return;
        }

        if (!pointerDown || activePointerId != (int)e.PointerId)
            return;

        dragX = e.ClientX;
        dragY = e.ClientY;

        if (!dragging && pointerDownSquare.HasValue)
        {
            var dx = dragX - startX;
            var dy = dragY - startY;

            if ((dx * dx + dy * dy) > DragThreshold * DragThreshold)
            {
                if (IsValidPieceSelection(pointerDownSquare.Value))
                {
                    dragging = true;
                    selectedSquare = pointerDownSquare;
                    validDestinations = GetValidMoveDestinations(pointerDownSquare.Value);
                }
            }
        }

        if (dragging)
            StateHasChanged();
    }

    private async Task OnPointerUp(PointerEventArgs e)
    {
        if (_activeDrawing.HasValue && drawingPointerId == (int)e.PointerId)
        {
            if (module is not null)
                await module.InvokeVoidAsync("releasePointerCapture", BoardGuid, drawingPointerId.Value);

            var squareIndex = _activeHoverSquareIndex;
            if (module is not null)
            {
                squareIndex = await module.InvokeAsync<int?>(
                    "getSquareIndexFromPoint",
                    e.ClientX,
                    e.ClientY,
                    BoardGuid);
            }

            if (squareIndex.HasValue)
            {
                var drawing = _activeDrawing.Value;
                if (drawing.StartSquareIndex == squareIndex.Value)
                {
                    ToggleCircle(squareIndex.Value, drawing.Color);
                }
                else
                {
                    ToggleArrow(drawing.StartSquareIndex, squareIndex.Value, drawing.Color);
                }
            }

            ResetDrawingState();
            StateHasChanged();
            return;
        }

        if (!pointerDown || activePointerId != (int)e.PointerId)
            return;

        if (module is not null)
            await module.InvokeVoidAsync("releasePointerCapture", BoardGuid, activePointerId.Value);

        if (dragging)
        {
            await HandleDragDrop(e);
        }
        else
        {
            HandleClick(pointerDownSquare);
        }

        ResetPointerState();
    }

    private async Task OnPointerCancel(PointerEventArgs e)
    {
        if (_activeDrawing.HasValue && drawingPointerId == (int)e.PointerId)
        {
            if (module is not null)
            {
                try
                {
                    await module.InvokeVoidAsync("releasePointerCapture", BoardGuid, drawingPointerId.Value);
                }
                catch
                {
                    // safe to ignore if already released
                }
            }

            ResetDrawingState();
            StateHasChanged();
            return;
        }

        if (activePointerId != (int)e.PointerId)
            return;

        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("releasePointerCapture", BoardGuid, activePointerId.Value);
            }
            catch
            {
                // safe to ignore if already released
            }
        }

        ResetPointerState();

        StateHasChanged();
    }

    private async Task HandleDragDrop(PointerEventArgs e)
    {
        if (module is null || pointerDownSquare is null)
            return;

        var index = await module.InvokeAsync<int?>(
            "getSquareIndexFromPoint",
            e.ClientX,
            e.ClientY,
            BoardGuid);

        if (!index.HasValue)
            return;

        var dropSquare = new Square(index.Value % 8, index.Value / 8);

        if (validDestinations.Contains(dropSquare))
            ApplyMove(pointerDownSquare.Value, dropSquare);
    }

    private void HandleClick(Square? square)
    {
        if (!square.HasValue)
            return;

        if (selectedSquare == null)
        {
            if (IsValidPieceSelection(square.Value))
            {
                selectedSquare = square;
                validDestinations = GetValidMoveDestinations(square.Value);
            }
        }
        else
        {
            if (square == selectedSquare)
            {
                selectedSquare = null;
                validDestinations.Clear();
                StateHasChanged();
                return;
            }

            if (validDestinations.Contains(square.Value))
                ApplyMove(selectedSquare.Value, square.Value);

            selectedSquare = null;
            validDestinations.Clear();
        }

        StateHasChanged();
    }

    private void ResetPointerState()
    {
        pointerDown = false;
        dragging = false;

        activePointerId = null;
        pointerDownSquare = null;

        dragPieceSvg = null;
    }

    private void ResetDrawingState()
    {
        _activeDrawing = null;
        _activeHoverSquareIndex = null;
        drawingPointerId = null;
    }

    private string GetDragPreviewStyle()
    {
        return $"left:{dragX}px;top:{dragY}px;transform:translate(-50%, -50%);";
    }

    private void ApplyMove(Square from, Square to)
    {
        var move = new Move(from, to);

        var piece = Game.CurrentPosition.Board[from.Index];
        if (piece?.Type == PieceType.Pawn && (to.Rank == 0 || to.Rank == 7))
        {
            move = new Move(from, to, PieceType.Queen);
        }
        else
        {
            var kingSquare = Game.CurrentPosition.Board.GetKingSquare(Game.CurrentPosition.SideToMove);
            if (from == kingSquare)
            {
                // Handle castling moves
                if (to.File == 6) // kingside
                    move = new Move(from, to, null, MoveType.CastlingKingSide);
                else if (to.File == 2) // queenside
                    move = new Move(from, to, null, MoveType.CastlingQueenSide);
            }
        }

        var state = Game.TryApplyMove(move);

        if (state == MoveState.Ok)
        {
            OnMovePlayed.InvokeAsync(move);
            InvokeAsync(StateHasChanged);
        }
    }

    private bool IsValidPieceSelection(Square square)
    {
        var piece = Game.CurrentPosition.Board[square.Index];

        return piece.HasValue
            // && PlayColor == piece.Value.Color // DEBUG: allow moving opponent's pieces for testing purposes
            && piece.Value.Color == Game.CurrentPosition.SideToMove;
    }

    private List<Square> GetValidMoveDestinations(Square from)
    {
        MoveState moveState;
        var moves = MoveValidator.GetValidMoves(from, Game.CurrentPosition, out moveState);
        return moves.Select(m => m.To).ToList();
    }

    private static bool IsLightSquare(int file, int rank)
        => (file + rank) % 2 != 0;

    private static string GetPieceSvg(Piece piece)
    {
        var pieceChar = FenSerializer.GetPieceString(piece.Type);
        var colorChar = piece.Color == PieceColor.White ? "l" : "d";

        return $"_content/pax.BlazorChess.Shared/Images/pieces/Chess_{pieceChar}{colorChar}t45.svg";
    }

    private static string GetMarkerId(string color)
    {
        return $"marker_{color.Replace("#", string.Empty, StringComparison.Ordinal)}";
    }

    private (double x, double y) GetSquareCenter(int squareIndex)
    {
        var square = new Square(squareIndex);
        var viewFile = BlackAtBottom ? 7 - square.File : square.File;
        var viewRank = BlackAtBottom ? square.Rank : 7 - square.Rank;
        const double squareSize = 12.5;
        return ((viewFile + 0.5) * squareSize, (viewRank + 0.5) * squareSize);
    }

    private static string SelectDrawColor(PointerEventArgs args)
    {
        if (args.ShiftKey && args.CtrlKey)
            return MarkerColors[3];

        if (args.ShiftKey)
            return MarkerColors[1];

        if (args.CtrlKey)
            return MarkerColors[2];

        return MarkerColors[0];
    }

    private void ToggleArrow(int startSquareIndex, int endSquareIndex, string color)
    {
        var existingIndex = _annotations.FindIndex(a =>
            a.IsArrow &&
            a.FromSquareIndex == startSquareIndex &&
            a.ToSquareIndex == endSquareIndex &&
            string.Equals(a.Color, color, StringComparison.OrdinalIgnoreCase));

        if (existingIndex >= 0)
        {
            _annotations.RemoveAt(existingIndex);
            return;
        }

        _annotations.Add(BoardAnnotation.Arrow(startSquareIndex, endSquareIndex, color));
    }

    private void ToggleCircle(int squareIndex, string color)
    {
        var existingIndex = _annotations.FindIndex(a =>
            !a.IsArrow &&
            a.FromSquareIndex == squareIndex &&
            string.Equals(a.Color, color, StringComparison.OrdinalIgnoreCase));

        if (existingIndex >= 0)
        {
            _annotations.RemoveAt(existingIndex);
            return;
        }

        _annotations.Add(BoardAnnotation.Circle(squareIndex, color));
    }

    private string GetSquareCssClass(Square square)
    {
        var classes = new List<string>();

        classes.Add(IsLightSquare(square.File, square.Rank) ? "square light" : "square dark");

        if (lastMove != null && (lastMove.From == square || lastMove.To == square))
            classes.Add("last-move");

        if (selectedSquare.HasValue && selectedSquare.Value == square)
            classes.Add("selected");

        if (validDestinations.Contains(square))
            classes.Add("valid-destination");

        return string.Join(' ', classes);
    }

    private static string GetSquareLabel(Square square, Piece? piece)
        => piece.HasValue ? $"{square}: {GetPieceAlt(piece.Value)}" : $"{square}: empty";

    private static string GetPieceAlt(Piece piece)
        => $"{piece.Color} {piece.Type}";

    private static string GetFileLabel(int file) => ((char)('a' + file)).ToString();

    private static string GetRankLabel(int rank) => (rank + 1).ToString();

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private readonly record struct ActiveDrawing(int StartSquareIndex, string Color);

    private readonly record struct BoardAnnotation(int FromSquareIndex, int ToSquareIndex, string Color, bool IsArrow)
    {
        public static BoardAnnotation Arrow(int fromSquareIndex, int toSquareIndex, string color) =>
            new(fromSquareIndex, toSquareIndex, color, IsArrow: true);

        public static BoardAnnotation Circle(int squareIndex, string color) =>
            new(squareIndex, squareIndex, color, IsArrow: false);
    }
}
