@using pax.BlazorChess.Shared.Interfaces
@using pax.chess
@using pax.uciChessEngine
@inject IEngineGameHandler EngineGameHandler
@implements IAsyncDisposable

<div class="container-fluid">
    <div class="btn-group">
        <button class="btn btn-primary" @onclick="Start">Start Engine Game</button>
        <button class="btn btn-primary" @onclick="() => StateHasChanged()">Refresh</button>
    </div>
    <div class="d-flex">
        <div class="w-50">
            <BoardComponent Game="game" />
        </div>
        <div class="w-25">
            <ClockComponent @ref="clockComponent" />
            <AnnotationComponent @ref="annotationComponent" />
            @if (game.Conclusion != null)
            {
                <div class="game-result mt-3">
                    Game Result: @game.Conclusion.Result / @game.Conclusion.Termination
                </div>
            }
        </div>
    </div>
</div>

@code {
    ChessGame game = new();
    ChessClock clock = new(TimeSpan.FromMinutes(1), TimeSpan.FromSeconds(0));
    ClockComponent? clockComponent;
    AnnotationComponent? annotationComponent;
    IEngineGame? engineGame;

    protected override void OnInitialized()
    {
        game.ActivatePositionHashing();
        game.OnMoveApplied += OnMoveMade;
        base.OnInitialized();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            if (clockComponent != null)
                clock.AttachDisplay(clockComponent);
        }
        base.OnAfterRender(firstRender);
    }

    private async Task Start()
    {
        engineGame = EngineGameHandler.GetEngineGame(game);
        await engineGame.Start(clock);
    }

    private void OnMoveMade(object? sender, EventArgs e)
    {
        var pos = game.PreviousPosition;
        var move = game.Moves.LastOrDefault();
        if (move != null && pos != null)
        {
            var moveString = PgnSerializer.ToSan(move.Move, pos);
            annotationComponent?.Update(moveString);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (engineGame != null)
        {
            await engineGame.DisposeAsync();
        }
        game.OnMoveApplied -= OnMoveMade;
    }
}
