@using pax.chess

<div class="container-fluid">
    <div class="d-flex">
        <CascadingValue Value="game">
            <div class="w-50">
                <BoardPlayComponent @ref="boardComponent" Game="game" />
            </div>
            <div class="w-25 mt-3">
                <ClockComponent @ref="clockComponent" />
                <AnnotationComponent @ref="annotationComponent" />
            </div>
        </CascadingValue>
    </div>
</div>


@code {
    ChessGame game = new();
    BoardPlayComponent? boardComponent;
    AnnotationComponent? annotationComponent;
    ClockComponent? clockComponent;
    ChessClock clock = new(TimeSpan.FromMinutes(3), TimeSpan.FromSeconds(2));
    bool firstMoveMade = false;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        game.SetClock(clock);
        game.OnMoveApplied += OnMoveMade;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            if (clockComponent != null)
                clock.AttachDisplay(clockComponent);
            clock.Start();
        }
        base.OnAfterRender(firstRender);
    }

    private void OnMoveMade(object? sender, EventArgs e)
    {
        if (!firstMoveMade)
        {
            firstMoveMade = true;
        }

        if (annotationComponent != null)
        {
            var move = game.Moves.LastOrDefault();
            var pos = game.PreviousPosition;
            if (move != null && pos != null)
            {
                boardComponent?.Update();
                var moveString = PgnSerializer.ToSan(move.Move, pos);
                annotationComponent?.Update(moveString);
            }
        }
    }
}
